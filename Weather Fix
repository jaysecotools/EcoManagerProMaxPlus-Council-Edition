                permissions: ['view_dashboard', 'create_projects', 'edit_projects', 'view_projects', 'create_assessments', 'edit_assessments', 'view_assessments', 'create_species', 'edit_species', 'view_species', 'create_maintenance', 'edit_maintenance', 'view_maintenance', 'approve_projects', 'view_charts', 'export_data', 'view_data', 'view_weather'],
