<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EcoManager Pro | Ecosystem Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css">
    <!-- Leaflet CSS for maps -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <!-- Leaflet Draw CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet-draw@1.0.4/dist/leaflet.draw.css"/>
    <!-- AOS Animation Library -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- jsPDF and html2canvas libraries for PDF generation -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <!-- SheetJS for Excel export -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <!-- Intro.js for user onboarding -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intro.js@4.3.0/minified/introjs.min.css">
    <script src="https://cdn.jsdelivr.net/npm/intro.js@4.3.0/minified/intro.min.js"></script>
    <style>
        :root {
            --primary: #2c5530;
            --secondary: #4a7c59;
            --accent: #3a8a5f;
            --accent-light: #4da675;
            --success: #28a745;
            --warning: #ffc107;
            --danger: #dc3545;
            --light: #f8f9fa;
            --dark: #1e2b1e;
            --sidebar-width: 280px;
            --transition: all 0.3s ease;
            --info: #17a2b8;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fa;
            color: #2c3e50;
            line-height: 1.6;
        }

        /* Sidebar Styles */
        .sidebar {
            min-height: 100vh;
            width: var(--sidebar-width);
            background: linear-gradient(to bottom, var(--primary), var(--secondary));
            color: white;
            position: fixed;
            z-index: 100;
            transition: var(--transition);
            box-shadow: 3px 0 15px rgba(0, 0, 0, 0.1);
        }

        .sidebar .nav-link {
            color: rgba(255, 255, 255, 0.85);
            margin-bottom: 5px;
            border-radius: 8px;
            padding: 12px 15px;
            transition: var(--transition);
            font-weight: 500;
        }

        .sidebar .nav-link:hover, .sidebar .nav-link.active {
            color: white;
            background-color: rgba(255, 255, 255, 0.1);
            transform: translateX(5px);
        }

        .sidebar .nav-link i {
            margin-right: 12px;
            font-size: 1.2rem;
            width: 24px;
            text-align: center;
        }

        .logo {
            font-weight: 700;
            padding: 20px 25px;
            font-size: 1.4rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            align-items: center;
            background-color: rgba(0, 0, 0, 0.1);
        }

        .logo i {
            margin-right: 10px;
            color: var(--accent-light);
        }

        /* Main Content */
        .main-content {
            margin-left: var(--sidebar-width);
            padding: 30px;
            transition: var(--transition);
        }

        .section-header {
            margin-bottom: 30px;
            padding-bottom: 15px;
            border-bottom: 1px solid rgba(0, 0, 0, 0.1);
        }

        .section-header h2 {
            font-weight: 600;
            color: var(--primary);
        }

        /* Card Styles */
        .card {
            margin-bottom: 25px;
            border: none;
            border-radius: 12px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
            transition: var(--transition);
        }

        .card:hover {
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
            transform: translateY(-5px);
        }

        .card-header {
            background-color: white;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            padding: 15px 20px;
            font-weight: 600;
            color: var(--primary);
            border-radius: 12px 12px 0 0 !important;
        }

        .stat-card {
            text-align: center;
            padding: 20px;
            border-left: 4px solid var(--accent);
        }

        .stat-card h3 {
            font-size: 2.2rem;
            font-weight: 700;
            margin: 10px 0;
        }

        .stat-card .card-title {
            color: var(--secondary);
            font-weight: 600;
        }

        /* Progress bar colors for health scores */
        .progress-bar.bg-success { background-color: var(--success) !important; }
        .progress-bar.bg-info { background-color: var(--info) !important; }
        .progress-bar.bg-warning { background-color: var(--warning) !important; }
        .progress-bar.bg-danger { background-color: var(--danger) !important; }
        .progress-bar.bg-dark { background-color: var(--dark) !important; }

        /* Table Styles */
        .table th {
            font-weight: 600;
            color: var(--primary);
            border-top: none;
        }

        .table-hover tbody tr:hover {
            background-color: rgba(58, 138, 95, 0.05);
        }

        /* Form Styles */
        .form-control, .form-select {
            padding: 12px 15px;
            border-radius: 8px;
            border: 1px solid #ddd;
            transition: var(--transition);
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 0.25rem rgba(58, 138, 95, 0.25);
        }

        .btn {
            border-radius: 8px;
            padding: 10px 20px;
            font-weight: 500;
            transition: var(--transition);
        }

        .btn-primary {
            background-color: var(--accent);
            border-color: var(--accent);
        }

        .btn-primary:hover {
            background-color: var(--accent-light);
            border-color: var(--accent-light);
            transform: translateY(-2px);
        }

        /* Badge Styles */
        .badge {
            padding: 8px 12px;
            border-radius: 20px;
            font-weight: 500;
        }

        /* Chart Containers */
        .chart-container {
            position: relative;
            height: 300px;
            margin-bottom: 20px;
        }

        /* Maintenance Items */
        .maintenance-item {
            border-left: 4px solid #6c757d;
            padding-left: 15px;
            margin-bottom: 15px;
            transition: var(--transition);
        }

        .maintenance-item:hover {
            background-color: rgba(0, 0, 0, 0.02);
        }

        .maintenance-pending {
            border-left-color: var(--warning);
        }

        .maintenance-completed {
            border-left-color: var(--success);
        }

        .maintenance-overdue {
            border-left-color: var(--danger);
        }

        .list-view, .calendar-view {
            display: none;
        }

        .list-view.active, .calendar-view.active {
            display: block;
        }

        /* Toast Notification */
        .toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1100;
        }

        /* View Toggle */
        .view-toggle {
            margin-bottom: 20px;
        }

        /* Content Sections */
        .content-section {
            display: none;
            animation: fadeIn 0.5s ease;
        }

        .content-section.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Risk Indicators */
        .risk-indicator {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            display: inline-block;
            margin-right: 5px;
        }

        .risk-low {
            background-color: var(--success);
        }

        .risk-medium {
            background-color: var(--warning);
        }

        .risk-high {
            background-color: var(--danger);
        }

        /* Map Styles */
        .map-container {
            height: 300px;
            border-radius: 8px;
            overflow: hidden;
            margin-bottom: 15px;
            width: 100%;
            max-width: 800px;
            margin-left: auto;
            margin-right: auto;
        }

        .location-coordinates {
            background-color: #f8f9fa;
            border-radius: 4px;
            padding: 8px 12px;
            font-family: monospace;
            font-size: 0.9rem;
        }

        .map-preview {
            height: 150px;
            border-radius: 6px;
            overflow: hidden;
            cursor: pointer;
        }

        /* For the modal map */
        #projectMapModal .modal-dialog {
            max-width: 900px;
        }

        #projectMapModal .map-container {
            height: 500px;
            width: 100%;
            border-radius: 8px;
            overflow: hidden;
            margin: 0;
        }

        /* Ensure the map takes full container */
        #modalProjectMap {
            height: 100%;
            width: 100%;
            min-height: 500px;
        }

        /* New Features */
        .progress-container {
            margin: 20px 0;
        }

        .progress {
            height: 10px;
            border-radius: 5px;
        }

        .project-card {
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .project-card:hover {
            transform: scale(1.02);
        }

        .quick-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 20px;
        }

        .quick-action-btn {
            flex: 1;
            min-width: 150px;
            text-align: center;
            padding: 15px;
            border-radius: 10px;
            background: white;
            box-shadow: 0 3px 10px rgba(0,0,0,0.08);
            transition: all 0.3s ease;
        }

        .quick-action-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        .quick-action-btn i {
            font-size: 1.5rem;
            margin-bottom: 10px;
            color: var(--accent);
        }

        .weather-widget {
            background: linear-gradient(135deg, #67b26f, #4ca2cd);
            color: white;
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 20px;
        }

        .weather-icon {
            font-size: 2rem;
            margin-bottom: 10px;
        }

        .ecosystem-health-indicator {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 15px;
        }

        .health-meter {
            width: 100px;
            height: 100px;
            position: relative;
        }

        .health-value {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 1.5rem;
            font-weight: bold;
        }

        /* Login Screen */
        #login-screen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: opacity 0.3s ease;
        }

        .login-container {
            background: white;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.2);
            width: 100%;
            max-width: 400px;
            animation: fadeInUp 0.5s ease;
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .user-role-badge {
            font-size: 0.7rem;
            padding: 2px 8px;
            margin-left: 8px;
        }

        /* Risk Matrix */
        .risk-matrix {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 2px;
            margin: 15px 0;
        }

        .risk-cell {
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
            font-weight: bold;
        }

        .risk-low { background-color: #d4edda; }
        .risk-medium { background-color: #fff3cd; }
        .risk-high { background-color: #f8d7da; }

        /* Document List */
        .document-item {
            display: flex;
            align-items: center;
            padding: 10px;
            border-bottom: 1px solid #eee;
            transition: background-color 0.2s;
        }

        .document-item:hover {
            background-color: #f8f9fa;
        }

        .document-icon {
            font-size: 1.5rem;
            margin-right: 15px;
            color: var(--primary);
        }

        /* Mobile Responsiveness */
        @media (max-width: 992px) {
            .sidebar {
                width: 70px;
                overflow: hidden;
            }
            
            .sidebar .logo span {
                display: none;
            }
            
            .sidebar .nav-link span {
                display: none;
            }
            
            .sidebar .nav-link i {
                margin-right: 0;
                font-size: 1.4rem;
            }
            
            .main-content {
                margin-left: 70px;
            }
            
            .sidebar:hover {
                width: var(--sidebar-width);
            }
            
            .sidebar:hover .logo span {
                display: inline;
            }
            
            .sidebar:hover .nav-link span {
                display: inline;
            }
            
            .sidebar:hover .nav-link i {
                margin-right: 12px;
            }
        }

        @media (max-width: 768px) {
            .sidebar {
                width: 100%;
                height: 70px;
                min-height: 70px;
                bottom: 0;
                top: auto;
                padding: 0;
            }
            
            .sidebar .logo {
                display: none;
            }
            
            .sidebar .nav {
                flex-direction: row;
                overflow-x: auto;
                padding: 0.5rem;
            }
            
            .sidebar .nav-item {
                flex-shrink: 0;
            }
            
            .sidebar .nav-link {
                padding: 0.5rem;
                margin-bottom: 0;
                margin-right: 5px;
                border-radius: 5px;
                text-align: center;
                font-size: 0.8rem;
            }
            
            .sidebar .nav-link i {
                margin-right: 0;
                display: block;
                margin-bottom: 0.25rem;
                font-size: 1.2rem;
            }
            
            .main-content {
                margin-left: 0;
                margin-bottom: 70px;
                padding: 15px;
            }
            
            .stat-card h3 {
                font-size: 1.8rem;
            }
            
            .quick-actions {
                flex-direction: column;
            }
        }

        /* Accessibility Improvements */
        .btn:focus, .form-control:focus, .form-select:focus {
            box-shadow: 0 0 0 3px rgba(58, 138, 95, 0.5);
        }
        
        .nav-link:focus {
            outline: 2px solid var(--accent-light);
            outline-offset: -2px;
        }
        
        /* High contrast support */
        @media (prefers-contrast: high) {
            .sidebar {
                background: var(--primary);
            }
            
            .card {
                border: 1px solid #ddd;
            }
        }
        
        /* Reduced motion support */
        @media (prefers-reduced-motion: reduce) {
            * {
                transition: none !important;
                animation: none !important;
            }
        }

        /* Dark Mode Support */
        @media (prefers-color-scheme: dark) {
            body {
                background-color: #121212;
                color: #e0e0e0;
            }
            
            .card {
                background-color: #1e1e1e;
                color: #e0e0e0;
            }
            
            .card-header {
                background-color: #252525;
                color: #e0e0e0;
            }
            
            .table {
                color: #e0e0e0;
            }
            
            .form-control, .form-select {
                background-color: #2d2d2d;
                border-color: #444;
                color: #e0e0e0;
            }
        }
    </style>
</head>
<body>
    <!-- Login Screen -->
    <div id="login-screen">
        <div class="login-container">
            <div class="text-center mb-4">
                <i class="bi bi-tree-fill" style="font-size: 3rem; color: var(--primary);"></i>
                <h2 class="mt-3">EcoManager Pro</h2>
                <p class="text-muted">Council Ecosystem Management System</p>
            </div>
            
            <div class="mb-4">
                <label class="form-label">Select User Role:</label>
                <select class="form-select" id="userRole">
                    <option value="viewer">Viewer (Read Only)</option>
                    <option value="staff">Field Staff</option>
                    <option value="manager">Project Manager</option>
                    <option value="admin">System Administrator</option>
                </select>
                <small class="text-muted">For demonstration purposes only</small>
            </div>
            
            <div class="mb-4">
                <label class="form-label">Password (demo):</label>
                <input type="password" class="form-control" id="demoPassword" value="council123">
            </div>
            
            <button class="btn btn-primary w-100 mb-3" onclick="login()">
                <i class="bi bi-box-arrow-in-right"></i> Enter System
            </button>
            
            <div class="text-center">
                <small class="text-muted">Version 1.0 • Council Demo Mode</small>
            </div>
        </div>
    </div>

    <div class="toast-container">
        <div id="liveToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header">
                <i class="bi bi-check-circle-fill text-success me-2"></i>
                <strong class="me-auto" id="toast-title">Notification</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body" id="toast-message">
                Operation completed successfully.
            </div>
        </div>
    </div>

    <div class="container-fluid p-0">
        <div class="row g-0">
            <!-- Sidebar -->
            <div class="sidebar">
                <div class="logo">
                    <i class="bi bi-tree-fill"></i>
                    <span>EcoManager Pro</span>
                </div>
                <div class="p-3">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link active" href="#" data-target="dashboard" aria-label="Dashboard">
                                <i class="bi bi-speedometer2"></i> <span>Dashboard</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#" data-target="projects" aria-label="Projects">
                                <i class="bi bi-folder"></i> <span>Projects</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#" data-target="assessments" aria-label="Assessments">
                                <i class="bi bi-clipboard-check"></i> <span>Assessments</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#" data-target="species" aria-label="Species">
                                <i class="bi bi-tree"></i> <span>Species</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#" data-target="maintenance" aria-label="Maintenance">
                                <i class="bi bi-tools"></i> <span>Maintenance</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#" data-target="charts" aria-label="Analytics">
                                <i class="bi bi-bar-chart"></i> <span>Analytics</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#" data-target="data" aria-label="Data">
                                <i class="bi bi-database"></i> <span>Data</span>
                            </a>
                        </li>
                        <!-- New Weather Menu Item -->
                        <li class="nav-item">
                            <a class="nav-link" href="#" data-target="weather" aria-label="Weather">
                                <i class="bi bi-cloud-sun"></i> <span>Weather</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#" id="userGuideBtn" aria-label="User Guide">
                                <i class="bi bi-question-circle"></i> <span>User Guide</span>
                            </a>
                        </li>
                        <li class="nav-item mt-4">
                            <div class="nav-link text-center">
                                <small class="text-white-50">Logged in as:</small>
                                <div id="currentUserRole" class="badge bg-light text-dark mt-1">Viewer</div>
                            </div>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-danger" href="#" onclick="logout()">
                                <i class="bi bi-box-arrow-right"></i> <span>Logout</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Main Content -->
            <div class="main-content">
                <!-- Dashboard Section -->
                <div id="dashboard" class="content-section active">
                    <div class="section-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h2>Dashboard</h2>
                                <p class="text-muted">Overview of your ecosystem management activities</p>
                            </div>
                            <div>
                                <button class="btn btn-outline-primary btn-sm" onclick="userOnboarding.showTour()">
                                    <i class="bi bi-info-circle"></i> Take Tour
                                </button>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Quick Actions -->
                    <div class="quick-actions">
                        <div class="quick-action-btn" data-target="projects">
                            <i class="bi bi-plus-circle"></i>
                            <h6>New Project</h6>
                        </div>
                        <div class="quick-action-btn" data-target="assessments">
                            <i class="bi bi-clipboard-plus"></i>
                            <h6>New Assessment</h6>
                        </div>
                        <div class="quick-action-btn" data-target="species">
                            <i class="bi bi-plus-square"></i>
                            <h6>Add Species</h6>
                        </div>
                        <div class="quick-action-btn" data-target="maintenance">
                            <i class="bi bi-tools"></i>
                            <h6>Schedule Maintenance</h6>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-3 col-sm-6">
                            <div class="card stat-card" data-aos="fade-up" data-aos-delay="0">
                                <div class="card-body">
                                    <h5 class="card-title">Projects</h5>
                                    <h3 id="projects-count" class="text-primary">0</h3>
                                    <p class="text-muted mb-0">Active initiatives</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <div class="card stat-card" data-aos="fade-up" data-aos-delay="100">
                                <div class="card-body">
                                    <h5 class="card-title">Assessments</h5>
                                    <h3 id="assessments-count" class="text-info">0</h3>
                                    <p class="text-muted mb-0">Surveys completed</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <div class="card stat-card" data-aos="fade-up" data-aos-delay="200">
                                <div class="card-body">
                                    <h5 class="card-title">Species</h5>
                                    <h3 id="species-count" class="text-success">0</h3>
                                    <p class="text-muted mb-0">Tracked species</p>
                                </div>
                            </div>
