            setTimeout(() => {
                userGuideSection.classList.add('active');
                document.title = 'User Guide | EcoManager Pro';
            }, 50);
        }

        // Simple database using localStorage
        const db = {
            init: function() {
                if (!localStorage.getItem('projects')) {
                    const sampleProjects = [
                        {
                            id: '1',
                            name: 'Burnie Coastal Restoration',
                            code: 'BCR001',
                            startDate: '2023-01-15',
                            status: 'active',
                            progress: 65,
                            description: 'Restoration of coastal vegetation in Burnie area',
                            latitude: -41.0521,
                            longitude: 145.9061,
                            budget: 150000,
                            fte: 2.5,
                            fundingSource: 'council',
                            approvalStatus: 'approved',
                            documents: [],
                            riskAssessment: 'Moderate risk due to coastal erosion'
                        },
                        {
                            id: '2',
                            name: 'Tasmanian Wetlands Preservation',
                            code: 'TWP002',
                            startDate: '2023-03-10',
                            status: 'planning',
                            progress: 20,
                            description: 'Preservation and monitoring of wetland ecosystems',
                            latitude: -42.8821,
                            longitude: 147.3272,
                            budget: 85000,
                            fte: 1.5,
                            fundingSource: 'state',
                            approvalStatus: 'pending_review',
                            documents: [],
                            riskAssessment: 'Low risk, high environmental value'
                        }
                    ];
                    localStorage.setItem('projects', JSON.stringify(sampleProjects));
                }
                if (!localStorage.getItem('assessments')) {
                    localStorage.setItem('assessments', JSON.stringify([]));
                }
                if (!localStorage.getItem('species')) {
                    localStorage.setItem('species', JSON.stringify([]));
                }
                if (!localStorage.getItem('maintenance')) {
                    localStorage.setItem('maintenance', JSON.stringify([]));
                }
                if (!localStorage.getItem('documents')) {
                    localStorage.setItem('documents', JSON.stringify([]));
                }
            },
            
            getProjects: function() {
                return JSON.parse(localStorage.getItem('projects') || '[]');
            },
            
            saveProject: function(project, user) {
                const validation = dataValidator.validateProject(project);
                if (!validation.isValid) {
                    showToast('Validation Error', validation.errors.join('<br>'), 'error');
                    return null;
                }
                
                project.name = dataValidator.sanitizeInput(project.name);
                project.description = dataValidator.sanitizeInput(project.description);
                
                const projects = this.getProjects();
                project.id = Date.now().toString();
                project.createdBy = user;
                project.createdAt = new Date().toISOString();
                projects.push(project);
                localStorage.setItem('projects', JSON.stringify(projects));
                
                auditLog.log('CREATE_PROJECT', {
                    projectId: project.id,
