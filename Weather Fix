            updateProject: function(id, updates, user) {
                const validation = dataValidator.validateProject(updates);
                if (!validation.isValid) {
                    showToast('Validation Error', validation.errors.join('<br>'), 'error');
                    return false;
                }
                
                let projects = this.getProjects();
                let updated = false;
                
                projects = projects.map(p => {
                    if (p.id === id) {
                        if (updates.name) updates.name = dataValidator.sanitizeInput(updates.name);
                        if (updates.description) updates.description = dataValidator.sanitizeInput(updates.description);
                        
                        const oldStatus = p.status;
                        const updatedProject = { ...p, ...updates, updatedBy: user, updatedAt: new Date().toISOString() };
                        
                        if (oldStatus !== updates.status) {
                            auditLog.log('UPDATE_PROJECT_STATUS', {
                                projectId: id,
                                projectName: p.name,
                                oldStatus: oldStatus,
                                newStatus: updates.status
                            });
                        }
                        
                        auditLog.log('UPDATE_PROJECT', {
                            projectId: id,
                            projectName: p.name,
                            updates: Object.keys(updates)
                        });
                        
                        updated = true;
                        return updatedProject;
                    }
                    return p;
                });
                
                if (updated) {
                    localStorage.setItem('projects', JSON.stringify(projects));
                }
                
                return updated;
            },
            
