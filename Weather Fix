        document.getElementById('projectForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const isEdit = this.dataset.editId;
            if (isEdit && !checkPermission('edit_projects')) {
                showToast('Permission Denied', 'You do not have permission to edit projects.', 'error');
                return;
            } else if (!isEdit && !checkPermission('create_projects')) {
                showToast('Permission Denied', 'You do not have permission to create projects.', 'error');
                return;
            }
            
            const project = {
                name: document.getElementById('projectName').value,
                code: document.getElementById('projectCode').value,
                startDate: document.getElementById('projectStartDate').value,
                status: document.getElementById('projectStatus').value,
                progress: parseInt(document.getElementById('projectProgress').value) || 0,
                description: document.getElementById('projectDescription').value,
                latitude: document.getElementById('projectLatitude').value,
                longitude: document.getElementById('projectLongitude').value,
                budget: document.getElementById('projectBudget').value ? parseInt(document.getElementById('projectBudget').value) : null,
                fte: document.getElementById('projectFTE').value ? parseFloat(document.getElementById('projectFTE').value) : null,
                fundingSource: document.getElementById('fundingSource').value,
                approvalStatus: document.getElementById('approvalStatus').value,
                riskAssessment: document.getElementById('riskAssessment').value
            };
            
            const editId = this.dataset.editId;
            if (editId) {
                const success = db.updateProject(editId, project, currentUser.role);
                if (success) {
                    delete this.dataset.editId;
                    this.querySelector('button[type="submit"]').textContent = 'Save Project';
                    showToast('Success', 'Project updated successfully');
                }
            } else {
                const savedProject = db.saveProject(project, currentUser.role);
                if (savedProject) {
                    showToast('Success', 'Project created successfully');
                }
            }
            
            if (editId || project) {
                this.reset();
                clearProjectMarker();
                document.getElementById('projectProgress').value = 0;
                document.getElementById('progressValue').textContent = '0%';
                loadProjects();
                loadDataSummary();
            }
        });

