function updateForecastChart(weatherData) {
    const tempChartCanvas = document.getElementById('temperatureChart');
    if (!tempChartCanvas) return;
    
    if (temperatureChart) temperatureChart.destroy();
    
    // Try to use real forecast data
    let labels = [];
    let temperatures = [];
    
    if (weatherData && weatherData.forecast && weatherData.forecast.forecastday) {
        // Use real forecast data
        labels = weatherData.forecast.forecastday.map(day => {
            const date = new Date(day.date);
            return date.toLocaleDateString('en-AU', { weekday: 'short' });
        });
        temperatures = weatherData.forecast.forecastday.map(day => day.day.avgtemp_c || day.day.maxtemp_c);
    } else {
        // Fallback to demo data
        labels = ['Today', '+1 day', '+2 days', '+3 days', '+4 days', '+5 days'];
        temperatures = [18, 19, 20, 19, 17, 16];
    }
    
    temperatureChart = new Chart(tempChartCanvas, {
        type: 'line',
        data: {
            labels: labels,
            datasets: [{
                label: 'Temperature (°C)',
                data: temperatures,
                borderColor: 'rgb(255, 99, 132)',
                backgroundColor: 'rgba(255, 99, 132, 0.2)',
                tension: 0.4,
                fill: true
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: false,
                    title: {
                        display: true,
                        text: 'Temperature (°C)'
                    }
                }
            }
        }
    });
}
```

