// API Key management
function initApiKeyManagement() {
    const savedKey = localStorage.getItem('weatherApiKey');
    const useDemo = localStorage.getItem('useDemoData') !== 'false';
    
    // Update the checkbox state
    const useDemoCheckbox = document.getElementById('useDemoData');
    if (useDemoCheckbox) {
        useDemoCheckbox.checked = useDemo;
    }
    
    if (savedKey && !useDemo) {
        weatherConfig.apiKey = savedKey;
        weatherConfig.useProxy = false;
        const apiKeyInput = document.getElementById('apiKeyInput');
        if (apiKeyInput) apiKeyInput.value = '••••••••••••••••';
    } else {
        weatherConfig.apiKey = '';  // Clear the key when using demo
        weatherConfig.useProxy = true;
        const apiKeyInput = document.getElementById('apiKeyInput');
        if (apiKeyInput) apiKeyInput.value = '';
    }
    
    const saveBtn = document.getElementById('saveApiKeyBtn');
    if (saveBtn) {
        saveBtn.addEventListener('click', function() {
            const apiKey = document.getElementById('apiKeyInput').value;
            const useDemoData = document.getElementById('useDemoData').checked;
            
            if (!useDemoData && (!apiKey || apiKey === '••••••••••••••••')) {
                showToast('API Key Required', 'Please enter a valid API key from weatherapi.com', 'warning');
                return;
            }
            
            if (!useDemoData) {
                localStorage.setItem('weatherApiKey', apiKey);
                localStorage.setItem('useDemoData', 'false');
                weatherConfig.apiKey = apiKey;
                weatherConfig.useProxy = false;
                showToast('API Key Saved', 'Your API key has been saved. Refresh weather data to see live conditions.', 'success');
            } else {
                localStorage.setItem('weatherApiKey', '');
                localStorage.setItem('useDemoData', 'true');
                weatherConfig.apiKey = '';
                weatherConfig.useProxy = true;
                showToast('Demo Mode', 'Using demo weather data', 'info');
            }
            
            loadWeatherData();
        });
    }
    
    const useDemoCheckboxElem = document.getElementById('useDemoData');
    if (useDemoCheckboxElem) {
        useDemoCheckboxElem.addEventListener('change', function() {
            const apiKeyInput = document.getElementById('apiKeyInput');
            if (apiKeyInput) {
                apiKeyInput.disabled = this.checked;
                if (this.checked) {
                    apiKeyInput.value = '';
                } else if (apiKeyInput.value === '') {
                    apiKeyInput.placeholder = 'Enter your API key';
                }
            }
        });
        
        // Initial state
        const apiKeyInput = document.getElementById('apiKeyInput');
        if (apiKeyInput) {
            apiKeyInput.disabled = useDemoCheckboxElem.checked;
        }
    }
}
