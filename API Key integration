    // New function to load health chart based on mode and filter
    function loadHealthChart() {
        const assessments = db.getAssessments();
        const projects = db.getProjects();
        
        // Filter by time range
        const cutoffDate = new Date();
        cutoffDate.setMonth(cutoffDate.getMonth() - currentTimeRange);
        
        let filteredAssessments = assessments.filter(a => new Date(a.date) >= cutoffDate);
        
        if (healthTrendChart) {
            healthTrendChart.destroy();
        }
        
        const ctx = document.getElementById('healthTrendChart');
        if (!ctx) return;
        
        if (currentChartMode === 'comparison' && currentProjectFilter === 'all') {
            // COMPARISON MODE: Show multiple projects as separate lines
            const activeProjects = projects.filter(p => p.status === 'active' || p.status === 'planning');
            const datasets = [];
            const colors = [
                'rgb(75, 192, 192)',   // Teal
                'rgb(54, 162, 235)',   // Blue
                'rgb(255, 99, 132)',   // Pink
                'rgb(255, 159, 64)',   // Orange
                'rgb(153, 102, 255)',  // Purple
                'rgb(255, 205, 86)'    // Yellow
            ];
            
            // Get all unique dates across all projects
            const allDates = new Set();
            activeProjects.forEach(project => {
                const projectAssessments = filteredAssessments.filter(a => a.projectId === project.id);
                projectAssessments.forEach(a => {
                    allDates.add(formatDate(a.date, 'short'));
                });
            });
            const sortedDates = Array.from(allDates).sort();
            
            activeProjects.forEach((project, index) => {
                const projectAssessments = filteredAssessments
                    .filter(a => a.projectId === project.id)
                    .sort((a, b) => new Date(a.date) - new Date(b.date));
                
                if (projectAssessments.length > 0) {
                    // Map assessments to dates
                    const assessmentMap = new Map();
                    projectAssessments.forEach(a => {
                        assessmentMap.set(formatDate(a.date, 'short'), getHealthValue(a.health));
                    });
                    
                    // Create data array matching sorted dates
                    const data = sortedDates.map(date => assessmentMap.get(date) || null);
                    
                    datasets.push({
