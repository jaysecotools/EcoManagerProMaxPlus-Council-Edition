With this:

```javascript
function initApp() {
    db.init();
    auditLog.init();
    loadDashboard();
    loadProjectSelects();
    initApiKeyManagement();
    setupViewToggle();
    loadDataSummary();
    
    // Initialize features
    formBuilder.init();
    setupHealthScorePreview();
    
    // Add this line
    setupHealthChartControls();
    
    // Weather initialization
    setupWeatherLocationSelector();
    
    // IMPORTANT: Load weather data on startup
    setTimeout(() => {
        loadWeatherData();
    }, 500);
    
    // User onboarding
    userOnboarding.showTooltips();
    
    // Initialize tooltips
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
    });

    // Fix table scrolling on initial load
    setTimeout(fixTableScrolling, 100);
}
```

