    // Setup health chart event listeners
    function setupHealthChartControls() {
        const filterSelect = document.getElementById('dashboardHealthFilter');
        const viewAggregatedBtn = document.getElementById('viewAggregatedBtn');
        const viewComparisonBtn = document.getElementById('viewComparisonBtn');
        const rangeButtons = document.querySelectorAll('[data-range]');
        
        if (filterSelect) {
            filterSelect.addEventListener('change', function() {
                currentProjectFilter = this.value;
                if (currentChartMode === 'aggregated' && currentProjectFilter !== 'all') {
                    // Switching to single project mode automatically
                    currentChartMode = 'single';
                    if (viewAggregatedBtn) viewAggregatedBtn.classList.remove('active');
                    if (viewComparisonBtn) viewComparisonBtn.classList.remove('active');
                }
                loadHealthChart();
            });
        }
        
        if (viewAggregatedBtn) {
            viewAggregatedBtn.addEventListener('click', function() {
                currentChartMode = 'aggregated';
                currentProjectFilter = 'all';
                if (filterSelect) filterSelect.value = 'all';
                viewAggregatedBtn.classList.add('active');
                if (viewComparisonBtn) viewComparisonBtn.classList.remove('active');
                loadHealthChart();
            });
        }
        
        if (viewComparisonBtn) {
            viewComparisonBtn.addEventListener('click', function() {
                currentChartMode = 'comparison';
                currentProjectFilter = 'all';
                if (filterSelect) filterSelect.value = 'all';
                viewComparisonBtn.classList.add('active');
                if (viewAggregatedBtn) viewAggregatedBtn.classList.remove('active');
                loadHealthChart();
            });
        }
        
        if (rangeButtons) {
            rangeButtons.forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    currentTimeRange = parseInt(this.dataset.range);
                    loadHealthChart();
                    
                    // Update button text
                    const dropdownBtn = document.querySelector('#dashboard .card-header .dropdown-toggle');
                    if (dropdownBtn) {
                        let text = 'Last ';
                        if (currentTimeRange === 3) text += '3 Months';
                        else if (currentTimeRange === 6) text += '6 Months';
                        else text += 'Year';
                        dropdownBtn.textContent = text;
                    }
                });
            });
        }
    }

