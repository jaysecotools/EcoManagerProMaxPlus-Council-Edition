    // Update project filter dropdown options
    function updateHealthFilterProjects() {
        const projects = db.getProjects();
        const filterSelect = document.getElementById('dashboardHealthFilter');
        
        if (!filterSelect) return;
        
        // Keep the "All Projects" option
        while (filterSelect.options.length > 1) {
            filterSelect.remove(1);
        }
        
        projects.forEach(project => {
            const option = document.createElement('option');
            option.value = project.id;
            option.textContent = project.name;
            option.dataset.hasAssessments = db.getAssessments().filter(a => a.projectId === project.id).length > 0;
            filterSelect.appendChild(option);
        });
