    // Data validation system
    const dataValidator = {
        validateProject: function(project) {
            const errors = [];
            
            // Name validation
            if (!project.name || project.name.trim().length < 3) {
                errors.push("Project name must be at least 3 characters");
            }
            
            if (project.name && project.name.length > 100) {
                errors.push("Project name cannot exceed 100 characters");
            }
            
            // Date validation
            if (project.startDate) {
                const startDate = new Date(project.startDate);
                if (startDate > new Date()) {
                    errors.push("Start date cannot be in the future");
                }
            }
            
            // Coordinate validation
            if (project.latitude && (project.latitude < -90 || project.latitude > 90)) {
                errors.push("Latitude must be between -90 and 90");
            }
            
            if (project.longitude && (project.longitude < -180 || project.longitude > 180)) {
                errors.push("Longitude must be between -180 and 180");
            }
            
            // Progress validation
            if (project.progress && (project.progress < 0 || project.progress > 100)) {
                errors.push("Progress must be between 0 and 100%");
            }
            
            // Budget validation
            if (project.budget && project.budget < 0) {
                errors.push("Budget cannot be negative");
            }
            
            return {
                isValid: errors.length === 0,
                errors: errors
            };
        },
        
        validateAssessment: function(assessment) {
            const errors = [];
            
            if (!assessment.assessor || assessment.assessor.trim().length < 2) {
                errors.push("Assessor name must be at least 2 characters");
            }
            
            if (assessment.date) {
                const assessmentDate = new Date(assessment.date);
                if (assessmentDate > new Date()) {
                    errors.push("Assessment date cannot be in the future");
                }
            }
            
            return {
                isValid: errors.length === 0,
                errors: errors
            };
        },
        
        sanitizeInput: function(input) {
            // Basic XSS protection
            if (typeof input === 'string') {
                return input
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#x27;')
                    .replace(/\//g, '&#x2F;');
            }
            return input;
        }
    };

