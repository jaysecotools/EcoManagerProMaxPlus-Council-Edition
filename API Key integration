    function updateHealthScorePreview() {
        const scoringData = {
            vegetationCover: document.getElementById('vegetationCover').value,
            nativeSpecies: document.getElementById('nativeSpecies').value,
            weedCover: document.getElementById('weedCover').value,
            soilStability: document.getElementById('soilStability').value,
            speciesRichness: document.getElementById('speciesRichness').value
        };
        
        // Only calculate if we have some data
        const hasData = Object.values(scoringData).some(val => val && val > 0);
        
        if (hasData) {
            const score = ecosystemScoring.calculateHealthScore(scoringData);
            
            const scoreValueSpan = document.getElementById('scoreValue');
            const scoreRatingSpan = document.getElementById('scoreRating');
            const progressBar = document.getElementById('scoreProgress');
            const scoreDisplay = document.getElementById('scoreDisplay');
            const healthScorePreview = document.getElementById('healthScorePreview');
            
            if (scoreValueSpan) scoreValueSpan.textContent = score.total;
            if (scoreRatingSpan) scoreRatingSpan.textContent = score.rating;
            
            if (progressBar) {
                progressBar.style.width = `${score.total}%`;
                progressBar.className = `progress-bar bg-${ecosystemScoring.getHealthColor(score.total)}`;
            }
            
            if (scoreDisplay) scoreDisplay.classList.remove('d-none');
            if (healthScorePreview) {
                const mutedSpan = healthScorePreview.querySelector('.text-muted');
                if (mutedSpan) mutedSpan.classList.add('d-none');
            }
        } else {
            const scoreDisplay = document.getElementById('scoreDisplay');
            const healthScorePreview = document.getElementById('healthScorePreview');
            
            if (scoreDisplay) scoreDisplay.classList.add('d-none');
            if (healthScorePreview) {
                const mutedSpan = healthScorePreview.querySelector('.text-muted');
                if (mutedSpan) mutedSpan.classList.remove('d-none');
            }
        }
    }

