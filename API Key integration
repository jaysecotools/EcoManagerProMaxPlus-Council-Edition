Replace it with:

```javascript
// WeatherAPI.com configuration - DIRECT API ACCESS
const weatherConfig = {
    apiKey: 'YOUR_API_KEY_HERE', // <-- PASTE YOUR API KEY HERE
    baseUrl: 'https://api.weatherapi.com/v1',
    useProxy: false, // Set to false for direct API access
    fallbackToExample: true
};
```

Step 3: Update the getWeatherByCoords Function

Replace the existing getWeatherByCoords function (around line 2200) with this enhanced version:

```javascript
async function getWeatherByCoords(lat, lon) {
    if (!weatherConfig.useProxy && weatherConfig.apiKey && weatherConfig.apiKey !== 'YOUR_API_KEY_HERE') {
        // Direct API call with your key
        try {
            const url = `${weatherConfig.baseUrl}/current.json?key=${weatherConfig.apiKey}&q=${lat},${lon}&aqi=yes`;
            const response = await fetch(url);
            
            if (!response.ok) {
                throw new Error(`API Error: ${response.status}`);
            }
            
            const data = await response.json();
            
            // Also fetch forecast for historical data
            const forecastUrl = `${weatherConfig.baseUrl}/forecast.json?key=${weatherConfig.apiKey}&q=${lat},${lon}&days=7&aqi=no`;
            const forecastResponse = await fetch(forecastUrl);
            
            if (forecastResponse.ok) {
                const forecastData = await forecastResponse.json();
                data.forecast = forecastData.forecast;
            }
            
            // Store in localStorage for offline access
            localStorage.setItem('lastWeatherData', JSON.stringify(data));
            localStorage.setItem('lastWeatherUpdate', new Date().toISOString());
            
            return data;
        } catch (error) {
            console.error('Weather API error:', error);
            if (weatherConfig.fallbackToExample) {
                showToast('Weather API', 'Using example data. Check your API key.', 'warning');
                return getExampleWeatherData(lat, lon);
            }
            return null;
        }
    } else {
        console.warn('API key not configured. Using example data.');
        showToast('Weather API', 'Please add your WeatherAPI.com API key to see live data.', 'info');
        return getExampleWeatherData(lat, lon);
    }
}

function getExampleWeatherData(lat, lon) {
    return {
        current: {
            temp_c: 18,
            condition: {
                text: "Partly Cloudy",
                code: 1003
            },
            humidity: 65,
            wind_kph: 12,
            pressure_mb: 1015,
            uv: 6,
            vis_km: 10,
            air_quality: {
                'us-epa-index': 2
            }
        },
        location: {
            name: getLocationNameFromCoords(lat, lon),
            region: "Demo Region",
            country: "Demo"
        },
        forecast: {
            forecastday: generateDemoForecast()
        }
    };
}

function getLocationNameFromCoords(lat, lon) {
    // Simple location name mapping for demo
    const locations = {
        '-41.0521,145.9061': 'Burnie, Tasmania',
        '-42.8821,147.3272': 'Hobart, Tasmania'
    };
    const key = `${lat},${lon}`;
    return locations[key] || 'Selected Location';
}

function generateDemoForecast() {
    const days = [];
    const today = new Date();
    for (let i = 0; i < 7; i++) {
        const date = new Date(today);
        date.setDate(today.getDate() + i);
        days.push({
            date: date.toISOString().split('T')[0],
            day: {
                maxtemp_c: 18 + Math.sin(i) * 3,
                mintemp_c: 10 + Math.cos(i) * 2,
                condition: { text: 'Partly cloudy' }
            }
        });
    }
    return { forecastday: days };
}
```

Step 4: Update the updateForecastChart Function

