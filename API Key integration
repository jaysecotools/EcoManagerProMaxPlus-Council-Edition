                loadProjects();
                loadAssessments();
                loadSpecies();
                loadMaintenance();
                loadProjectSelects();
                
                auditLog.log('IMPORT_DATA', {
                    fileName: file.name,
                    fileSize: file.size,
                    overwrite: overwriteData ? overwriteData.checked : false
                });
                
                showToast('Import Successful', 'Data has been imported successfully', 'success');
                
                // Clear the file input
                fileInput.value = '';
                
            } catch (error) {
                console.error('Import error:', error);
                showToast('Import Error', 'Failed to import data. Please check the file format.', 'error');
            }
