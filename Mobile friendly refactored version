    // ==================== CHART FUNCTIONS ====================
    function loadHealthChart() {
        const assessments = db.getAssessments().sort((a, b) => new Date(a.date) - new Date(b.date));
        const ctx = document.getElementById('healthTrendChart');
        if (!ctx) return;
        if (healthTrendChart) healthTrendChart.destroy();
        
        const healthValues = { excellent: 5, good: 4, fair: 3, poor: 2, degraded: 1 };
        
        healthTrendChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: assessments.map(a => formatDate(a.date)),
                datasets: [{
                    label: 'Overall Health Score',
                    data: assessments.map(a => healthValues[a.health] || 3),
                    borderColor: 'rgb(75, 192, 192)',
                    backgroundColor: 'rgba(75, 192, 192, 0.1)',
                    tension: 0.3,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: { y: { min: 1, max: 5, ticks: { callback: v => ({1:'Degraded',2:'Poor',3:'Fair',4:'Good',5:'Excellent'})[v] } } }
            }
        });
    }

    function loadProjectStatusChart() {
        const projects = db.getProjects();
        const statusCount = { planning: 0, active: 0, 'on-hold': 0, completed: 0 };
        projects.forEach(p => statusCount[p.status]++);
        
        const ctx = document.getElementById('projectStatusChart');
        if (!ctx) return;
        if (projectStatusChart) projectStatusChart.destroy();
        
        projectStatusChart = new Chart(ctx, {
            type: 'doughnut',
            data: { labels: ['Planning', 'Active', 'On Hold', 'Completed'], datasets: [{ data: Object.values(statusCount), backgroundColor: ['#36a2eb', '#4bc0c0', '#ffce56', '#9966ff'] }] },
            options: { responsive: true, maintainAspectRatio: false }
        });
    }

    function loadAnalyticsCharts() {
        // Analytics Health Trends
        const assessments = db.getAssessments().sort((a, b) => new Date(a.date) - new Date(b.date));
        const ctx1 = document.getElementById('analyticsHealthTrendChart');
        if (ctx1) {
            if (analyticsHealthTrendChart) analyticsHealthTrendChart.destroy();
            const healthValues = { excellent: 5, good: 4, fair: 3, poor: 2, degraded: 1 };
            analyticsHealthTrendChart = new Chart(ctx1, {
                type: 'line',
                data: { labels: assessments.map(a => formatDate(a.date)), datasets: [{ label: 'Ecosystem Health Score', data: assessments.map(a => healthValues[a.health] || 3), borderColor: 'rgb(75, 192, 192)', tension: 0.3 }] },
                options: { responsive: true, maintainAspectRatio: false }
            });
        }
        
        // Species Type Chart
        const species = db.getSpecies();
        const speciesTypeData = { plant: 0, animal: 0, bird: 0, reptile: 0, insect: 0 };
        species.forEach(s => speciesTypeData[s.type]++);
        
