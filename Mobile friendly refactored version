    <script src="https://cdn.jsdelivr.net/npm/@turf/turf@6/turf.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    
    <script>
    // ==================== COMPLETE REFACTORED APPLICATION ====================
    
    // Global variables
    let currentUser = { role: 'viewer', name: 'Demo User', permissions: [] };
    let projectMap = null, projectMarker = null, modalProjectMap = null, calendar = null;
    let projectStatusChart = null, healthTrendChart = null, analyticsHealthTrendChart = null;
    let speciesTypeChart = null, maintenanceTypeChart = null;
    
    const userRoles = {
        viewer: { name: 'Viewer', permissions: ['view_dashboard', 'view_projects', 'view_assessments', 'view_species', 'view_maintenance', 'view_charts', 'view_data', 'view_weather'], color: 'info' },
        staff: { name: 'Field Staff', permissions: ['view_dashboard', 'view_projects', 'create_assessments', 'view_assessments', 'create_species', 'view_species', 'create_maintenance', 'view_maintenance', 'complete_maintenance', 'view_charts', 'view_data', 'view_weather'], color: 'success' },
        manager: { name: 'Project Manager', permissions: ['view_dashboard', 'create_projects', 'edit_projects', 'view_projects', 'create_assessments', 'edit_assessments', 'view_assessments', 'create_species', 'edit_species', 'view_species', 'create_maintenance', 'edit_maintenance', 'view_maintenance', 'approve_projects', 'view_charts', 'export_data', 'view_data', 'view_weather'], color: 'warning' },
        admin: { name: 'System Administrator', permissions: ['all'], color: 'danger' }
    };

    // ==================== DATA LAYER ====================
    const db = {
        init: function() {
            if (!localStorage.getItem('projects')) {
                localStorage.setItem('projects', JSON.stringify([
                    { id: '1', name: 'Burnie Coastal Restoration', code: 'BCR001', startDate: '2023-01-15', status: 'active', progress: 65, description: 'Restoration of coastal vegetation in Burnie area', latitude: -41.0521, longitude: 145.9061, budget: 150000, fte: 2.5, fundingSource: 'council' },
                    { id: '2', name: 'Tasmanian Wetlands Preservation', code: 'TWP002', startDate: '2023-03-10', status: 'planning', progress: 20, description: 'Preservation and monitoring of wetland ecosystems', latitude: -42.8821, longitude: 147.3272, budget: 85000, fte: 1.5, fundingSource: 'state' }
                ]));
            }
            if (!localStorage.getItem('assessments')) localStorage.setItem('assessments', JSON.stringify([]));
            if (!localStorage.getItem('species')) localStorage.setItem('species', JSON.stringify([]));
            if (!localStorage.getItem('maintenance')) localStorage.setItem('maintenance', JSON.stringify([]));
        },
        getProjects: () => JSON.parse(localStorage.getItem('projects') || '[]'),
        getAssessments: () => JSON.parse(localStorage.getItem('assessments') || '[]'),
        getSpecies: () => JSON.parse(localStorage.getItem('species') || '[]'),
        getMaintenance: () => JSON.parse(localStorage.getItem('maintenance') || '[]'),
        
        saveProject: function(project) {
            const projects = this.getProjects();
            project.id = Date.now().toString();
            projects.push(project);
            localStorage.setItem('projects', JSON.stringify(projects));
            return project;
        },
        
        updateProject: function(id, updates) {
            let projects = this.getProjects();
            projects = projects.map(p => p.id === id ? { ...p, ...updates } : p);
            localStorage.setItem('projects', JSON.stringify(projects));
            return true;
        },
        
        saveAssessment: function(assessment) {
            const assessments = this.getAssessments();
            assessment.id = Date.now().toString();
            assessments.push(assessment);
            localStorage.setItem('assessments', JSON.stringify(assessments));
            return assessment;
        },
        
        saveSpecies: function(species) {
            const allSpecies = this.getSpecies();
            species.id = Date.now().toString();
            allSpecies.push(species);
            localStorage.setItem('species', JSON.stringify(allSpecies));
            return species;
        },
        
        saveMaintenance: function(maintenance) {
            const items = this.getMaintenance();
            maintenance.id = Date.now().toString();
            maintenance.status = 'scheduled';
            items.push(maintenance);
            localStorage.setItem('maintenance', JSON.stringify(items));
            return maintenance;
        },
        
        updateMaintenanceStatus: function(id, status) {
            let items = this.getMaintenance();
            items = items.map(item => item.id === id ? { ...item, status, completedDate: status === 'completed' ? new Date().toISOString().split('T')[0] : item.completedDate } : item);
            localStorage.setItem('maintenance', JSON.stringify(items));
            return true;
        },
        
        deleteProject: function(id) {
            let projects = this.getProjects().filter(p => p.id !== id);
            localStorage.setItem('projects', JSON.stringify(projects));
            return true;
        },
        
        deleteAssessment: function(id) {
            let assessments = this.getAssessments().filter(a => a.id !== id);
            localStorage.setItem('assessments', JSON.stringify(assessments));
            return true;
        },
        
        deleteSpecies: function(id) {
            let species = this.getSpecies().filter(s => s.id !== id);
            localStorage.setItem('species', JSON.stringify(species));
            return true;
        },
        
        deleteMaintenance: function(id) {
            let items = this.getMaintenance().filter(m => m.id !== id);
            localStorage.setItem('maintenance', JSON.stringify(items));
            return true;
        }
    };

    // ==================== UTILITY FUNCTIONS ====================
    function showToast(title, message, type = 'success') {
        const toast = document.getElementById('liveToast');
        const toastTitle = document.getElementById('toast-title');
        const toastMessage = document.getElementById('toast-message');
        if (!toast) return;
        
        toastTitle.textContent = title;
        toastMessage.innerHTML = message;
        const header = toast.querySelector('.toast-header');
        header.className = 'toast-header';
        if (type === 'error') header.classList.add('bg-danger', 'text-white');
        else if (type === 'warning') header.classList.add('bg-warning', 'text-dark');
        else header.classList.add('bg-success', 'text-white');
        
        new bootstrap.Toast(toast).show();
    }

    function formatDate(dateString) {
        if (!dateString) return 'Not specified';
        return new Date(dateString).toLocaleDateString('en-AU');
    }

    function getProjectName(projectId) {
        if (!projectId) return 'Unassigned';
        const project = db.getProjects().find(p => p.id === projectId);
        return project ? project.name : 'Unknown Project';
    }

    function getHealthBadgeClass(health) {
        const map = { excellent: 'bg-success', good: 'bg-info', fair: 'bg-warning', poor: 'bg-danger', degraded: 'bg-dark' };
        return map[health] || 'bg-secondary';
    }

    function getPriorityBadgeClass(priority) {
        const map = { low: 'bg-info', medium: 'bg-warning', high: 'bg-danger' };
        return map[priority] || 'bg-secondary';
    }

    function getMaintenanceStatusClass(item) {
        if (item.status === 'completed') return 'maintenance-completed';
        return new Date(item.date) < new Date() ? 'maintenance-overdue' : 'maintenance-pending';
    }

    function checkPermission(permission) {
        if (currentUser.permissions.includes('all')) return true;
        return currentUser.permissions.includes(permission);
    }

