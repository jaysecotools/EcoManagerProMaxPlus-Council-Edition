            maintenanceTypeChart = new Chart(ctx3, {
                type: 'bar',
                data: { labels: Object.keys(maintenanceTypeData).map(k => k.replace('-', ' ').toUpperCase()), datasets: [{ label: 'Number of Activities', data: Object.values(maintenanceTypeData), backgroundColor: '#36a2eb' }] },
                options: { responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } } }
