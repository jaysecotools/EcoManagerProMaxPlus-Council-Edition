    // ==================== MAP FUNCTIONS ====================
    function initProjectMap() {
        const mapContainer = document.getElementById('projectMap');
        if (!mapContainer) return;
        if (projectMap) projectMap.remove();
        
        projectMap = L.map('projectMap').setView([-41.0521, 145.9061], 11);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '© OpenStreetMap contributors' }).addTo(projectMap);
        
        const lat = document.getElementById('projectLatitude')?.value;
        const lng = document.getElementById('projectLongitude')?.value;
        if (lat && lng) setProjectMarker(parseFloat(lat), parseFloat(lng));
        
        return projectMap;
    }

    function setProjectMarker(lat, lng) {
        const latInput = document.getElementById('projectLatitude');
        const lngInput = document.getElementById('projectLongitude');
        if (latInput) latInput.value = lat;
        if (lngInput) lngInput.value = lng;
        if (projectMarker) projectMap.removeLayer(projectMarker);
        projectMarker = L.marker([lat, lng]).addTo(projectMap).bindPopup('Project Location').openPopup();
        projectMap.setView([lat, lng], 10);
    }

    function clearProjectMarker() {
        if (projectMarker) projectMap.removeLayer(projectMarker);
        const latInput = document.getElementById('projectLatitude');
        const lngInput = document.getElementById('projectLongitude');
        if (latInput) latInput.value = '';
        if (lngInput) lngInput.value = '';
    }

    function useCurrentLocation() {
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                position => setProjectMarker(position.coords.latitude, position.coords.longitude),
                error => showToast('Location Error', 'Unable to retrieve your location', 'error')
            );
        } else {
            showToast('Location Error', 'Geolocation not supported', 'error');
        }
    }

    function showProjectInModal(projectId) {
        const project = db.getProjects().find(p => p.id === projectId);
        if (!project) return;
        
        const modalTitle = document.getElementById('projectMapModalTitle');
        const modalCoordinates = document.getElementById('modalCoordinates');
        const modalMapContainer = document.getElementById('modalProjectMap');
        
        if (modalTitle) modalTitle.textContent = `${project.name} Location`;
        
        if (modalMapContainer) {
            modalMapContainer.innerHTML = '<div id="modalMap" style="height: 100%; width: 100%;"></div>';
            
            if (modalProjectMap) modalProjectMap.remove();
            modalProjectMap = L.map('modalMap').setView([-41.0521, 145.9061], 11);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '© OpenStreetMap contributors' }).addTo(modalProjectMap);
            
            if (project.latitude && project.longitude) {
                const lat = parseFloat(project.latitude), lng = parseFloat(project.longitude);
                L.marker([lat, lng]).addTo(modalProjectMap).bindPopup(project.name).openPopup();
                modalProjectMap.setView([lat, lng], 10);
                if (modalCoordinates) modalCoordinates.textContent = `Coordinates: ${lat.toFixed(6)}, ${lng.toFixed(6)}`;
            } else {
                if (modalCoordinates) modalCoordinates.textContent = 'Coordinates: Not specified';
            }
            setTimeout(() => modalProjectMap.invalidateSize(), 100);
        }
        
        new bootstrap.Modal(document.getElementById('projectMapModal')).show();
    }

    // ==================== CALENDAR FUNCTIONS ====================
    function loadCalendar() {
        const calendarEl = document.getElementById('calendar');
        if (!calendarEl) return;
        
        if (calendar) calendar.destroy();
        
        calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            headerToolbar: { left: 'prev,next today', center: 'title', right: 'dayGridMonth,timeGridWeek' },
            events: db.getMaintenance().map(item => ({
                id: item.id, title: `${item.activity} (${getProjectName(item.projectId)})`, start: item.date, allDay: true,
                backgroundColor: item.priority === 'high' ? '#dc3545' : item.priority === 'medium' ? '#ffc107' : '#28a745',
                extendedProps: { type: item.type, priority: item.priority, status: item.status, description: item.description, projectId: item.projectId }
            })),
            eventClick: function(info) {
                const event = info.event;
                const modalContent = `
                    <p><strong>Project:</strong> ${getProjectName(event.extendedProps.projectId)}</p>
                    <p><strong>Date:</strong> ${formatDate(event.startStr)}</p>
                    <p><strong>Type:</strong> ${event.extendedProps.type?.replace('-', ' ').toUpperCase()}</p>
                    <p><strong>Priority:</strong> <span class="badge ${getPriorityBadgeClass(event.extendedProps.priority)}">${event.extendedProps.priority?.toUpperCase()}</span></p>
                    <p><strong>Status:</strong> <span class="badge">${event.extendedProps.status}</span></p>
                    <p><strong>Description:</strong> ${event.extendedProps.description}</p>
                `;
                document.getElementById('modalMaintenanceTitle').textContent = event.title;
                document.getElementById('modalMaintenanceBody').innerHTML = modalContent;
                
                const completeBtn = document.getElementById('modalCompleteButton');
                if (event.extendedProps.status === 'scheduled' && checkPermission('complete_maintenance')) {
                    completeBtn.style.display = 'block';
                    completeBtn.onclick = () => { completeMaintenance(event.id); bootstrap.Modal.getInstance(document.getElementById('maintenanceModal')).hide(); };
                } else {
                    completeBtn.style.display = 'none';
                }
                new bootstrap.Modal(document.getElementById('maintenanceModal')).show();
            }
        });
        calendar.render();
    }

    // ==================== DATA EXPORT/IMPORT ====================
    function exportData() {
        const projectId = document.getElementById('exportProject')?.value;
        const format = document.querySelector('input[name="exportFormat"]:checked')?.value;
        
        if (format === 'json') {
            const data = {
                projects: projectId === 'all' ? db.getProjects() : db.getProjects().filter(p => p.id === projectId),
                assessments: projectId === 'all' ? db.getAssessments() : db.getAssessments().filter(a => a.projectId === projectId),
                species: projectId === 'all' ? db.getSpecies() : db.getSpecies().filter(s => s.projectId === projectId),
                maintenance: projectId === 'all' ? db.getMaintenance() : db.getMaintenance().filter(m => m.projectId === projectId),
                exportedAt: new Date().toISOString()
            };
            const dataStr = JSON.stringify(data, null, 2);
            const link = document.createElement('a');
            link.href = 'data:application/json;charset=utf-8,' + encodeURIComponent(dataStr);
            link.download = `ecomanager-${projectId === 'all' ? 'all' : projectId}-${new Date().toISOString().slice(0,10)}.json`;
            link.click();
            showToast('Export Successful', 'Data exported successfully');
        } else if (format === 'pdf') {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF();
            doc.setFontSize(20);
            doc.text('EcoManager Pro Report', 105, 15, { align: 'center' });
            doc.setFontSize(12);
            doc.text(`Generated: ${new Date().toLocaleDateString()}`, 105, 25, { align: 'center' });
            doc.save(`ecomanager-report-${new Date().toISOString().slice(0,10)}.pdf`);
            showToast('PDF Export', 'PDF report generated');
        } else if (format === 'excel') {
            const wb = XLSX.utils.book_new();
            const projectsSheet = XLSX.utils.json_to_sheet(db.getProjects().map(p => ({ Name: p.name, Status: p.status, Progress: p.progress })));
            XLSX.utils.book_append_sheet(wb, projectsSheet, 'Projects');
            XLSX.writeFile(wb, `ecomanager-${new Date().toISOString().slice(0,10)}.xlsx`);
            showToast('Excel Export', 'Excel file generated');
        }
    }

    function importData() {
        const fileInput = document.getElementById('importFile');
        const overwrite = document.getElementById('overwriteData')?.checked;
        
        if (!fileInput?.files.length) {
            showToast('Import Error', 'Please select a file', 'error');
            return;
        }
        
        const reader = new FileReader();
        reader.onload = function(e) {
            try {
                const data = JSON.parse(e.target.result);
                if (overwrite) {
                    localStorage.setItem('projects', JSON.stringify(data.projects || []));
                    localStorage.setItem('assessments', JSON.stringify(data.assessments || []));
                    localStorage.setItem('species', JSON.stringify(data.species || []));
                    localStorage.setItem('maintenance', JSON.stringify(data.maintenance || []));
                }
                loadDashboard();
                loadProjects();
                loadAssessments();
                loadSpecies();
                loadMaintenance();
                showToast('Import Successful', 'Data imported successfully');
                fileInput.value = '';
            } catch (error) {
                showToast('Import Error', 'Invalid file format', 'error');
            }
        };
        reader.readAsText(fileInput.files[0]);
    }

    // ==================== DELETE FUNCTIONS ====================
    function deleteProject(id) {
        if (confirm('Delete this project and all associated data?')) {
            db.getAssessments().forEach(a => { if (a.projectId === id) db.deleteAssessment(a.id); });
            db.getSpecies().forEach(s => { if (s.projectId === id) db.deleteSpecies(s.id); });
            db.getMaintenance().forEach(m => { if (m.projectId === id) db.deleteMaintenance(m.id); });
            db.deleteProject(id);
            loadProjects();
            loadDashboard();
            showToast('Success', 'Project deleted');
        }
    }

    function deleteAssessment(id) {
        if (confirm('Delete this assessment?')) {
            db.deleteAssessment(id);
            loadAssessments();
            loadDashboard();
            showToast('Success', 'Assessment deleted');
        }
    }

    function deleteSpecies(id) {
        if (confirm('Delete this species?')) {
            db.deleteSpecies(id);
            loadSpecies();
            loadDashboard();
            showToast('Success', 'Species deleted');
        }
    }

    function deleteMaintenance(id) {
        if (confirm('Delete this maintenance activity?')) {
            db.deleteMaintenance(id);
            loadMaintenance();
            loadDashboard();
            showToast('Success', 'Maintenance deleted');
        }
    }

    function completeMaintenance(id) {
        if (confirm('Mark this maintenance as completed?')) {
            db.updateMaintenanceStatus(id, 'completed');
            loadMaintenance();
            loadDashboard();
            showToast('Success', 'Maintenance completed');
        }
    }

    // ==================== NAVIGATION (CONSOLIDATED) ====================
    function navigateTo(sectionId) {
        document.querySelectorAll('.sidebar .nav-link').forEach(l => l.classList.remove('active'));
        const targetLink = document.querySelector(`[data-target="${sectionId}"]`);
        if (targetLink) targetLink.classList.add('active');
        
        document.querySelectorAll('.content-section').forEach(section => section.classList.remove('active'));
        const targetSection = document.getElementById(sectionId);
        if (targetSection) targetSection.classList.add('active');
        
        // Load section-specific data
        const loaders = {
            dashboard: loadDashboard,
            projects: () => { loadProjects(); setTimeout(initProjectMap, 100); },
            assessments: loadAssessments,
            species: loadSpecies,
            maintenance: () => { loadMaintenance(); if (document.querySelector('[data-view="calendar-view"]')?.classList.contains('active')) loadCalendar(); },
            charts: loadAnalyticsCharts,
            data: loadDataSummary,
            weather: loadWeatherData
        };
        if (loaders[sectionId]) loaders[sectionId]();
        
        fixMobileLayout();
    }

    // ==================== VIEW TOGGLE ====================
    function setupViewToggle() {
        const viewButtons = document.querySelectorAll('.view-toggle button');
        const listView = document.getElementById('list-view');
        const calendarView = document.getElementById('calendar-view');
        
        viewButtons.forEach(btn => {
            btn.addEventListener('click', function() {
                viewButtons.forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                const targetView = this.getAttribute('data-view');
                if (targetView === 'list-view') {
                    listView.classList.add('active');
                    calendarView.classList.remove('active');
                } else {
                    listView.classList.remove('active');
                    calendarView.classList.add('active');
                    loadCalendar();
                }
            });
        });
    }

    // ==================== MOBILE LAYOUT FIX ====================
    function fixMobileLayout() {
        if (window.innerWidth <= 768) {
            document.querySelectorAll('.main-content .row [class*="col-"]').forEach(col => {
                col.style.width = '100%';
                col.style.maxWidth = '100%';
                col.style.flex = '0 0 100%';
            });
        }
        window.dispatchEvent(new Event('resize'));
    }

    // ==================== USER ONBOARDING ====================
    const userOnboarding = {
        showTour: function() {
            introJs().setOptions({
                steps: [
                    { element: document.querySelector('.logo'), intro: 'Welcome to EcoManager Pro!', position: 'right' },
                    { element: document.querySelector('.sidebar'), intro: 'Use the sidebar to navigate between sections.', position: 'right' },
                    { element: document.querySelector('#dashboard'), intro: 'The Dashboard gives you an overview of all activities.', position: 'bottom' },
                    { element: document.querySelector('.quick-actions'), intro: 'Quick Actions let you create new items quickly.', position: 'bottom' }
                ],
                showProgress: true
            }).start();
        }
    };

    // ==================== FORM HANDLERS ====================
    function setupFormHandlers() {
        document.getElementById('projectForm')?.addEventListener('submit', function(e) {
            e.preventDefault();
            const project = {
                name: document.getElementById('projectName').value,
                code: document.getElementById('projectCode').value,
                startDate: document.getElementById('projectStartDate').value,
                status: document.getElementById('projectStatus').value,
                progress: parseInt(document.getElementById('projectProgress').value) || 0,
                description: document.getElementById('projectDescription').value,
                latitude: document.getElementById('projectLatitude').value,
                longitude: document.getElementById('projectLongitude').value
            };
            db.saveProject(project);
            this.reset();
            document.getElementById('projectProgress').value = 0;
            document.getElementById('progressValue').textContent = '0%';
            clearProjectMarker();
            loadProjects();
            showToast('Success', 'Project created');
        });
        
        document.getElementById('assessmentForm')?.addEventListener('submit', function(e) {
            e.preventDefault();
            const assessment = {
                date: document.getElementById('assessmentDate').value,
                assessor: document.getElementById('assessor').value,
                health: document.getElementById('healthStatus').value,
                projectId: document.getElementById('assessmentProject').value,
                description: document.getElementById('assessmentDescription').value
            };
            db.saveAssessment(assessment);
            this.reset();
            loadAssessments();
            showToast('Success', 'Assessment saved');
        });
        
        document.getElementById('speciesForm')?.addEventListener('submit', function(e) {
            e.preventDefault();
            const species = {
                name: document.getElementById('speciesName').value,
                scientificName: document.getElementById('scientificName').value,
                type: document.getElementById('speciesType').value,
                status: document.getElementById('speciesStatus').value,
                projectId: document.getElementById('speciesProject').value,
                description: document.getElementById('speciesDescription').value
            };
            db.saveSpecies(species);
            this.reset();
            loadSpecies();
            showToast('Success', 'Species added');
        });
        
        document.getElementById('maintenanceForm')?.addEventListener('submit', function(e) {
            e.preventDefault();
            const maintenance = {
                activity: document.getElementById('maintenanceActivity').value,
                type: document.getElementById('maintenanceType').value,
                date: document.getElementById('maintenanceDate').value,
                priority: document.getElementById('maintenancePriority').value,
                projectId: document.getElementById('maintenanceProject').value,
                description: document.getElementById('maintenanceDescription').value
            };
            db.saveMaintenance(maintenance);
            this.reset();
            loadMaintenance();
            showToast('Success', 'Maintenance scheduled');
        });
        
        document.getElementById('projectProgress')?.addEventListener('input', function() {
            document.getElementById('progressValue').textContent = `${this.value}%`;
        });
        
        document.getElementById('projectSearch')?.addEventListener('input', function() {
            const term = this.value.toLowerCase();
            document.querySelectorAll('#projects-table tr').forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(term) ? '' : 'none';
            });
        });
        
        document.getElementById('assessmentProjectFilter')?.addEventListener('change', loadAssessments);
        document.getElementById('speciesProjectFilter')?.addEventListener('change', loadSpecies);
        document.getElementById('maintenanceProjectFilter')?.addEventListener('change', loadMaintenance);
        document.getElementById('exportButton')?.addEventListener('click', exportData);
        document.getElementById('importButton')?.addEventListener('click', importData);
        document.getElementById('useCurrentLocation')?.addEventListener('click', useCurrentLocation);
        document.getElementById('clearLocation')?.addEventListener('click', clearProjectMarker);
    }

    // ==================== AUTHENTICATION ====================
    window.login = function() {
        const userRole = document.getElementById('userRole').value;
        const password = document.getElementById('demoPassword').value;
        
        if (password === 'council123') {
            currentUser = { role: userRole, name: userRoles[userRole].name, permissions: userRoles[userRole].permissions };
            document.getElementById('currentUserRole').textContent = userRoles[userRole].name;
            document.getElementById('currentUserRole').className = `badge bg-${userRoles[userRole].color} text-dark mt-1`;
            document.getElementById('login-screen').style.display = 'none';
            showToast('Welcome', `Logged in as ${userRoles[userRole].name}`);
            loadDashboard();
        } else {
            showToast('Login Failed', 'Invalid password. Use "council123"', 'error');
        }
    };
    
    window.logout = function() {
        currentUser = { role: 'viewer', name: 'Demo User', permissions: [] };
        document.getElementById('login-screen').style.display = 'flex';
        navigateTo('dashboard');
    };

    // ==================== INITIALIZATION ====================
    function initApp() {
        db.init();
        setupFormHandlers();
        setupViewToggle();
        loadDashboard();
        loadProjects();
        loadAssessments();
        loadSpecies();
        loadMaintenance();
        loadDataSummary();
        
        document.querySelectorAll('.sidebar .nav-link[data-target]').forEach(link => {
            link.addEventListener('click', (e) => { e.preventDefault(); navigateTo(link.getAttribute('data-target')); });
        });
        document.querySelectorAll('.quick-action-btn').forEach(btn => {
            btn.addEventListener('click', () => navigateTo(btn.getAttribute('data-target')));
        });
        document.getElementById('userGuideBtn')?.addEventListener('click', () => showToast('User Guide', 'Documentation available', 'info'));
        
        window.addEventListener('resize', fixMobileLayout);
        fixMobileLayout();
        AOS.init({ duration: 800, once: true });
    }
    
    document.addEventListener('DOMContentLoaded', initApp);
    
    // Expose functions globally
    window.navigateTo = navigateTo;
    window.deleteProject = deleteProject;
    window.deleteAssessment = deleteAssessment;
    window.deleteSpecies = deleteSpecies;
    window.deleteMaintenance = deleteMaintenance;
    window.completeMaintenance = completeMaintenance;
    window.showProjectInModal = showProjectInModal;
    window.userOnboarding = userOnboarding;
    </script>
</body>
