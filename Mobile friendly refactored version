                type: 'pie',
                data: { labels: Object.keys(speciesTypeData).map(k => k.charAt(0).toUpperCase() + k.slice(1)), datasets: [{ data: Object.values(speciesTypeData), backgroundColor: ['#4bc0c0', '#36a2eb', '#ffce56', '#9966ff', '#ff9f40'] }] },
                options: { responsive: true, maintainAspectRatio: false }
