7. LOW: Missing saveProjectBoundary Function

This function is referenced but not fully implemented.

Fix - Add this function:

```javascript
function saveProjectBoundary(latlngs) {
    const boundary = latlngs[0].map(latlng => [latlng.lat, latlng.lng]);
    
    // Calculate area using turf.js if available
    let areaHectares = 0;
    if (typeof turf !== 'undefined' && turf.area) {
        const polygon = turf.polygon([boundary]);
        const area = turf.area(polygon);
        areaHectares = (area / 10000).toFixed(2);
        showToast('Project Area', `Project boundary set. Area: ${areaHectares} hectares`, 'success');
    } else {
        showToast('Project Area', 'Project boundary saved. Area calculation requires turf.js', 'info');
    }
    
    // Store in localStorage for the current project
    const editId = document.getElementById('projectForm')?.dataset?.editId;
    if (editId) {
        const projects = db.getProjects();
        const project = projects.find(p => p.id === editId);
        if (project) {
            project.boundary = boundary;
            project.areaHectares = areaHectares;
            localStorage.setItem('projects', JSON.stringify(projects));
        }
    }
}
```

