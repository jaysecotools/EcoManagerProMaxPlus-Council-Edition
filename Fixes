// ==================== WEATHER FUNCTIONS ====================
let currentWeatherLat = -41.0521, currentWeatherLon = 145.9061;
let currentLocationName = 'Burnie, TAS';

async function getLocationNameFromCoords(lat, lon) {
    try {
        const response = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lon}&zoom=10`);
        if (response.ok) {
            const data = await response.json();
            return data.display_name?.split(',')[0] || `${lat.toFixed(2)}, ${lon.toFixed(2)}`;
        }
    } catch (e) { console.log('Reverse geocoding failed'); }
    return `${lat.toFixed(2)}, ${lon.toFixed(2)}`;
}

async function loadWeatherData() {
    const useDemoData = localStorage.getItem('useDemoData') !== 'false';
    const savedApiKey = localStorage.getItem('weatherApiKey');
    
    document.getElementById('current-temp').textContent = '--°C';
    document.getElementById('weather-description').textContent = 'Loading...';
    
    if (!useDemoData && savedApiKey && savedApiKey !== 'YOUR_API_KEY_HERE' && savedApiKey !== '••••••••••••••••') {
        try {
            const response = await fetch(`https://api.weatherapi.com/v1/current.json?key=${savedApiKey}&q=${currentWeatherLat},${currentWeatherLon}&aqi=yes`);
            if (response.ok) {
                const data = await response.json();
                updateWeatherDisplay(data.current, data.location);
                const forecastRes = await fetch(`https://api.weatherapi.com/v1/forecast.json?key=${savedApiKey}&q=${currentWeatherLat},${currentWeatherLon}&days=7`);
                if (forecastRes.ok) updateForecastChart(await forecastRes.json());
                updateHistoricalChart();
                document.getElementById('lastUpdate').textContent = `Last updated: ${new Date().toLocaleTimeString()}`;
                return;
            }
        } catch(e) { console.log('API error, using demo'); }
    }
    // Demo data
    updateWeatherDisplay({ temp_c: 22, condition: { text: 'Partly Cloudy' }, humidity: 65, wind_kph: 12, pressure_mb: 1013 }, { name: currentLocationName });
    updateForecastChart(null);
    updateHistoricalChart();
    document.getElementById('lastUpdate').textContent = `Last updated: ${new Date().toLocaleTimeString()} (Demo)`;
}

function updateWeatherDisplay(current, location) {
    document.getElementById('current-temp').textContent = `${Math.round(current.temp_c)}°C`;
    document.getElementById('weather-description').textContent = current.condition.text;
    document.getElementById('weather-location-name').textContent = location.name || currentLocationName;
    document.getElementById('humidity').textContent = `${current.humidity}%`;
    document.getElementById('wind-speed').textContent = `${Math.round(current.wind_kph)} km/h`;
    document.getElementById('pressure').textContent = `${current.pressure_mb} hPa`;
    
    const alerts = document.getElementById('environmental-alerts');
    let alertHtml = '<div class="alert alert-success"><i class="bi bi-check-circle"></i> <strong>Favorable Conditions</strong><p>Weather conditions are suitable for ecosystem management.</p></div>';
    if (current.temp_c > 30) alertHtml = '<div class="alert alert-warning"><i class="bi bi-thermometer-sun"></i> <strong>High Temperature Alert</strong><p>Extreme heat may stress vegetation. Consider postponing fieldwork.</p></div>';
    else if (current.wind_kph > 30) alertHtml = '<div class="alert alert-warning"><i class="bi bi-wind"></i> <strong>Strong Wind Alert</strong><p>High winds may affect monitoring activities and increase fire risk.</p></div>';
    else if (current.humidity > 80) alertHtml = '<div class="alert alert-info"><i class="bi bi-droplet"></i> <strong>High Humidity</strong><p>Increased disease risk for some species.</p></div>';
    alerts.innerHTML = alertHtml;
}

