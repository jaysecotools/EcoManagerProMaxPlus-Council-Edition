            if (text === null || text === undefined) return '';
            let result = String(text);
            result = result.replace(/[\x00-\x08\x0B\x0C\x0E-\x1F\x7F]/g, '');
            result = result.replace(/[&<>]/g, function(match) {
                if (match === '&') return 'and';
                if (match === '<') return '<';
                if (match === '>') return '>';
                return match;
            });
            return result.trim();
        }
        
