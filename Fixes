function getLocationNameFromCoords(lat, lon) {
    // Simple function to return a location name based on coordinates
    if (Math.abs(lat + 41.0521) < 0.1 && Math.abs(lon - 145.9061) < 0.1) {
        return "Burnie";
    } else if (Math.abs(lat + 42.8821) < 0.1 && Math.abs(lon - 147.3272) < 0.1) {
        return "Hobart";
    } else if (Math.abs(lat + 37.8136) < 0.1 && Math.abs(lon - 144.9631) < 0.1) {
        return "Melbourne";
    }
    return `Location (${lat.toFixed(2)}, ${lon.toFixed(2)})`;
}
