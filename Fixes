// Also fix the date formatting function to ensure clean output
function formatDate(dateString, format = 'full') {
    if (!dateString) return 'Not specified';
    try {
        const date = new Date(dateString);
        if (isNaN(date.getTime())) return dateString; // Return original if invalid
        
        if (format === 'short') {
            return `${date.getDate().toString().padStart(2, '0')}/${(date.getMonth() + 1).toString().padStart(2, '0')}`;
        }
        
        return `${date.getDate().toString().padStart(2, '0')}/${(date.getMonth() + 1).toString().padStart(2, '0')}/${date.getFullYear()}`;
    } catch (e) {
        return dateString;
    }
}

// Also fix the addWrappedText function to ensure clean text rendering
function addWrappedText(doc, text, x, y, maxWidth, lineHeight, fontStyle = 'normal') {
    if (!text || text === 'undefined') return y;
    
    // Clean the text - remove any special characters that might cause encoding issues
    let cleanText = String(text)
        .replace(/[^\x20-\x7E\u00A0-\u00FF]/g, '') // Remove non-printable chars
        .replace(/\s+/g, ' ') // Normalize spaces
        .trim();
    
    if (cleanText.length === 0) return y;
    
    doc.setFont(undefined, fontStyle);
    const lines = doc.splitTextToSize(cleanText, maxWidth);
    doc.text(lines, x, y);
    return y + (lines.length * lineHeight);
}

// Fix the getProjectName function to ensure clean output
function getProjectName(projectId) {
    if (!projectId) return 'Unassigned';
    try {
        const projects = db.getProjects();
        const project = projects.find(p => p.id === projectId);
        if (project && project.name) {
            // Clean the project name
            return String(project.name).replace(/[^\x20-\x7E]/g, '').substring(0, 40);
        }
        return 'Unknown Project';
    } catch (e) {
        return 'Unknown Project';
    }
}
