function getCleanMaintenanceData() {
    try {
        const rawData = localStorage.getItem('maintenance');
        if (!rawData) return [];
        
        // Parse and clean each item
        const items = JSON.parse(rawData);
        return items.map(item => ({
            id: String(item.id || ''),
            activity: String(item.activity || '').replace(/[^\x20-\x7E]/g, ''),
            type: String(item.type || 'other').replace(/[^\x20-\x7E]/g, ''),
            date: String(item.date || ''),
            status: String(item.status || 'scheduled').replace(/[^\x20-\x7E]/g, ''),
            priority: String(item.priority || 'medium').replace(/[^\x20-\x7E]/g, ''),
            projectId: String(item.projectId || ''),
            description: String(item.description || '').replace(/[^\x20-\x7E]/g, ''),
            completedDate: item.completedDate ? String(item.completedDate) : null,
            completedBy: item.completedBy ? String(item.completedBy) : null
        }));
    } catch (e) {
        console.error('Error cleaning maintenance data:', e);
        return [];
    }
}
