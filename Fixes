function exportToPDF(projectId) {
    try {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({
            unit: 'mm',
            format: 'a4',
            orientation: 'portrait'
        });
        
        // Get data
        const projects = projectId === 'all' ? db.getProjects() : db.getProjects().filter(p => p.id === projectId);
        const assessments = projectId === 'all' ? db.getAssessments() : db.getAssessments().filter(a => a.projectId === projectId);
        const species = projectId === 'all' ? db.getSpecies() : db.getSpecies().filter(s => s.projectId === projectId);
        const maintenance = projectId === 'all' ? db.getMaintenance() : db.getMaintenance().filter(m => m.projectId === projectId);
        
        // Helper function for wrapped text
        function addWrappedText(doc, text, x, y, maxWidth, lineHeight) {
            if (!text) return y;
            const lines = doc.splitTextToSize(text, maxWidth);
            doc.text(lines, x, y);
            return y + (lines.length * lineHeight);
        }
        
        // Calculate statistics safely
        const stats = {
            totalProjects: projects.length,
            activeProjects: projects.filter(p => p.status === 'active').length,
            completedProjects: projects.filter(p => p.status === 'completed').length,
            totalAssessments: assessments.length,
            avgHealthScore: 0,
            totalSpecies: species.length,
            nativeSpecies: species.filter(s => s.status === 'native').length,
            totalMaintenance: maintenance.length,
            completedMaintenance: maintenance.filter(m => m.status === 'completed').length,
            totalBudget: projects.reduce((sum, p) => sum + (parseFloat(p.budget) || 0), 0)
        };
        
        // Calculate average health score safely
        if (assessments.length > 0) {
            const healthScores = {
                excellent: 90,
                good: 75,
                fair: 55,
                poor: 35,
                degraded: 20
            };
            let totalScore = 0;
            assessments.forEach(a => {
                totalScore += healthScores[a.health] || 50;
            });
            stats.avgHealthScore = Math.round(totalScore / assessments.length);
        }
        
        // ========== PAGE 1: COVER ==========
        doc.setFontSize(22);
        doc.setFont(undefined, 'bold');
        doc.text('EcoManager Pro', 105, 60, { align: 'center' });
        
        doc.setFontSize(14);
        doc.setFont(undefined, 'normal');
        doc.text('Professional Ecosystem Management Report', 105, 72, { align: 'center' });
        
        doc.setFontSize(11);
        const reportType = projectId === 'all' ? 'COMPREHENSIVE ORGANISATIONAL REPORT' : 'PROJECT-SPECIFIC REPORT';
        doc.text(reportType, 105, 85, { align: 'center' });
        
        if (projectId !== 'all' && projects[0]) {
            const project = projects[0];
            doc.setFontSize(13);
            doc.setFont(undefined, 'bold');
            doc.text(project.name, 105, 110, { align: 'center' });
            
            doc.setFontSize(10);
            doc.setFont(undefined, 'normal');
            doc.text(`Status: ${project.status.toUpperCase()} | Progress: ${project.progress || 0}%`, 105, 120, { align: 'center' });
        }
        
        doc.setFontSize(9);
        doc.text(`Generated: ${new Date().toLocaleString('en-AU')}`, 105, 145, { align: 'center' });
        doc.text(`Generated by: ${currentUser.role.toUpperCase()}`, 105, 152, { align: 'center' });
        
        // ========== PAGE 2: EXECUTIVE SUMMARY ==========
        doc.addPage();
        
        doc.setFontSize(16);
        doc.setFont(undefined, 'bold');
        doc.text('Executive Summary', 20, 25);
        
        let yPos = 40;
        yPos = addWrappedText(doc, 
            `This report provides a comprehensive overview of ecosystem management activities${projectId !== 'all' ? ' for the selected project' : ' across all projects'}.`, 
            20, yPos, 170, 6);
        yPos += 5;
        
        // Key metrics boxes
        const metrics = [
            { label: 'Total Projects', value: stats.totalProjects, x: 20 },
            { label: 'Active Projects', value: stats.activeProjects, x: 65 },
            { label: 'Completion Rate', value: stats.totalProjects > 0 ? Math.round((stats.completedProjects / stats.totalProjects) * 100) : 0, unit: '%', x: 110 },
            { label: 'Health Score', value: stats.avgHealthScore, unit: '/100', x: 155 }
        ];
        
        metrics.forEach(metric => {
            doc.setFillColor(245, 245, 245);
            doc.roundedRect(metric.x, yPos, 40, 25, 3, 3, 'F');
            doc.setFontSize(8);
            doc.setFont(undefined, 'normal');
            doc.text(metric.label, metric.x + 3, yPos + 6);
            doc.setFontSize(16);
            doc.setFont(undefined, 'bold');
            doc.text(metric.value.toString(), metric.x + 3, yPos + 18);
            doc.setFontSize(7);
            doc.setFont(undefined, 'normal');
            if (metric.unit) doc.text(metric.unit, metric.x + 3, yPos + 23);
        });
        
        yPos += 35;
        
        // Key insights
        doc.setFontSize(12);
        doc.setFont(undefined, 'bold');
        doc.text('Key Insights', 20, yPos);
        yPos += 8;
        
        doc.setFontSize(9);
        doc.setFont(undefined, 'normal');
        
        const insights = [
            `• Ecosystem health score is ${stats.avgHealthScore}/100`,
            `• ${stats.activeProjects} active projects, ${stats.completedProjects} completed`,
            `• ${stats.nativeSpecies} native species documented (${stats.totalSpecies > 0 ? Math.round((stats.nativeSpecies / stats.totalSpecies) * 100) : 0}% of total)`,
            `• ${stats.completedMaintenance} of ${stats.totalMaintenance} maintenance tasks completed`,
            `• Total investment: $${stats.totalBudget.toLocaleString()}`
        ];
        
        insights.forEach(insight => {
            yPos = addWrappedText(doc, insight, 20, yPos, 170, 5);
            yPos += 2;
        });
        
        // ========== PAGE 3: PROJECTS ==========
        if (projects.length > 0) {
            doc.addPage();
            
            doc.setFontSize(16);
            doc.setFont(undefined, 'bold');
            doc.text('Project Portfolio', 20, 25);
            
            let projY = 40;
            
            projects.slice(0, 5).forEach((project, index) => {
                if (projY > 250) {
                    doc.addPage();
                    projY = 25;
                }
                
                doc.setFontSize(11);
                doc.setFont(undefined, 'bold');
                doc.text(`${index + 1}. ${project.name.substring(0, 50)}`, 20, projY);
                projY += 6;
                
                // Progress bar
                const progress = project.progress || 0;
                doc.setFillColor(220, 220, 220);
                doc.rect(20, projY, 60, 4, 'F');
                doc.setFillColor(58, 138, 95);
                doc.rect(20, projY, 60 * (progress / 100), 4, 'F');
                doc.setFontSize(8);
                doc.setFont(undefined, 'normal');
                doc.text(`Progress: ${progress}%`, 85, projY + 3);
                projY += 8;
                
                doc.setFontSize(8);
                doc.text(`Status: ${project.status} | Start: ${formatDate(project.startDate)} | Budget: $${(project.budget || 0).toLocaleString()}`, 20, projY);
                projY += 6;
                
                if (project.description) {
                    projY = addWrappedText(doc, project.description.substring(0, 150), 20, projY, 170, 4);
                    projY += 3;
                }
                
                projY += 8;
            });
            
            if (projects.length > 5) {
                doc.setFontSize(8);
                doc.text(`+ ${projects.length - 5} additional projects not shown`, 20, projY);
            }
        }
        
        // ========== PAGE 4: ASSESSMENTS ==========
        if (assessments.length > 0) {
            doc.addPage();
            
            doc.setFontSize(16);
            doc.setFont(undefined, 'bold');
            doc.text('Ecosystem Health Assessments', 20, 25);
            
            let assY = 40;
            
            // Health distribution summary
            const healthCounts = {
                excellent: assessments.filter(a => a.health === 'excellent').length,
                good: assessments.filter(a => a.health === 'good').length,
                fair: assessments.filter(a => a.health === 'fair').length,
                poor: assessments.filter(a => a.health === 'poor').length,
                degraded: assessments.filter(a => a.health === 'degraded').length
            };
            
            doc.setFontSize(10);
            doc.setFont(undefined, 'bold');
            doc.text('Health Status Distribution', 20, assY);
            assY += 8;
            
            doc.setFontSize(8);
            doc.setFont(undefined, 'normal');
            Object.entries(healthCounts).forEach(([status, count]) => {
                if (count > 0) {
                    doc.text(`${status}: ${count} (${Math.round((count / assessments.length) * 100)}%)`, 25, assY);
                    assY += 5;
                }
            });
            
            assY += 8;
            
            // Recent assessments
            doc.setFontSize(10);
            doc.setFont(undefined, 'bold');
            doc.text('Recent Assessments', 20, assY);
            assY += 8;
            
            assessments.slice(-5).reverse().forEach(assessment => {
                if (assY > 260) {
                    doc.addPage();
                    assY = 25;
                }
                
                doc.setFontSize(8);
                doc.setFont(undefined, 'bold');
                doc.text(`${formatDate(assessment.date)} - ${assessment.assessor.substring(0, 30)}`, 25, assY);
                assY += 5;
                
                doc.setFont(undefined, 'normal');
                doc.text(`Health: ${assessment.health || 'Not rated'} | Project: ${getProjectName(assessment.projectId)}`, 25, assY);
                assY += 5;
                
                if (assessment.description) {
                    assY = addWrappedText(doc, assessment.description.substring(0, 100), 30, assY, 155, 4);
                    assY += 3;
                }
                
                assY += 5;
            });
        }
        
        // ========== PAGE 5: SPECIES ==========
        if (species.length > 0) {
            doc.addPage();
            
            doc.setFontSize(16);
            doc.setFont(undefined, 'bold');
            doc.text('Species Inventory', 20, 25);
            
            let specY = 40;
            
            // Species by type
            const typeCount = {
                plant: species.filter(s => s.type === 'plant').length,
                animal: species.filter(s => s.type === 'animal').length,
                bird: species.filter(s => s.type === 'bird').length,
                reptile: species.filter(s => s.type === 'reptile').length,
                insect: species.filter(s => s.type === 'insect').length
            };
            
            doc.setFontSize(9);
            doc.setFont(undefined, 'bold');
            doc.text('Species by Type:', 20, specY);
            specY += 6;
            
            doc.setFont(undefined, 'normal');
            Object.entries(typeCount).forEach(([type, count]) => {
                if (count > 0) {
                    doc.text(`${type}: ${count}`, 25, specY);
                    specY += 5;
                }
            });
            
            specY += 8;
            
            // Species table
            doc.setFillColor(230, 230, 230);
            doc.rect(20, specY, 50, 6, 'F');
            doc.rect(70, specY, 50, 6, 'F');
            doc.rect(120, specY, 30, 6, 'F');
            doc.rect(150, specY, 30, 6, 'F');
            
            doc.setFontSize(7);
            doc.setFont(undefined, 'bold');
            doc.text('Common Name', 22, specY + 4.5);
            doc.text('Scientific Name', 72, specY + 4.5);
            doc.text('Type', 122, specY + 4.5);
            doc.text('Status', 152, specY + 4.5);
            specY += 8;
            
            doc.setFont(undefined, 'normal');
            species.slice(0, 15).forEach(s => {
                if (specY > 270) {
                    doc.addPage();
                    specY = 25;
                }
                doc.text(s.name.substring(0, 20), 22, specY + 3);
                doc.text((s.scientificName || '-').substring(0, 20), 72, specY + 3);
                doc.text(s.type, 122, specY + 3);
                doc.text(s.status, 152, specY + 3);
                specY += 5;
            });
            
            if (species.length > 15) {
                specY += 3;
                doc.setFontSize(7);
                doc.text(`+ ${species.length - 15} additional species`, 20, specY);
            }
        }
        
        // ========== PAGE 6: MAINTENANCE ==========
        if (maintenance.length > 0) {
            doc.addPage();
            
            doc.setFontSize(16);
            doc.setFont(undefined, 'bold');
            doc.text('Maintenance Activities', 20, 25);
            
            let maintY = 40;
            
            const upcoming = maintenance.filter(m => m.status === 'scheduled').slice(0, 8);
            
            if (upcoming.length > 0) {
                doc.setFontSize(10);
                doc.setFont(undefined, 'bold');
                doc.text('Upcoming Scheduled Tasks', 20, maintY);
                maintY += 8;
                
                upcoming.forEach(item => {
                    if (maintY > 260) {
                        doc.addPage();
                        maintY = 25;
                    }
                    
                    doc.setFontSize(8);
                    doc.setFont(undefined, 'bold');
                    doc.text(`• ${item.activity.substring(0, 40)}`, 25, maintY);
                    maintY += 5;
                    
                    doc.setFont(undefined, 'normal');
                    doc.text(`  Date: ${formatDate(item.date)} | Priority: ${item.priority} | Project: ${getProjectName(item.projectId)}`, 25, maintY);
                    maintY += 5;
                    
                    if (item.description) {
                        maintY = addWrappedText(doc, `  ${item.description.substring(0, 80)}`, 25, maintY, 155, 4);
                        maintY += 2;
                    }
                    
                    maintY += 5;
                });
            }
        }
        
        // ========== PAGE 7: RECOMMENDATIONS ==========
        doc.addPage();
        
        doc.setFontSize(16);
        doc.setFont(undefined, 'bold');
        doc.text('Recommendations', 20, 25);
        
        let recY = 40;
        
        const recommendations = [
            'Continue regular ecosystem health assessments to track improvement',
            'Prioritize maintenance tasks based on ecological impact',
            'Increase native species planting in areas with low biodiversity',
            'Enhance community engagement and volunteer programs',
            'Consider additional funding for high-priority conservation areas'
        ];
        
        recommendations.forEach(rec => {
            recY = addWrappedText(doc, `• ${rec}`, 20, recY, 170, 6);
            recY += 3;
        });
        
        // Footer with page numbers
        const pageCount = doc.internal.getNumberOfPages();
        for (let i = 1; i <= pageCount; i++) {
            doc.setPage(i);
            doc.setFontSize(8);
            doc.setTextColor(128, 128, 128);
            doc.text(`EcoManager Pro - Page ${i} of ${pageCount}`, 105, 290, { align: 'center' });
        }
        
        // Save the PDF
        const fileName = `EcoManager_Report_${projectId === 'all' ? 'All_Projects' : (projects[0]?.name || 'Project').replace(/\s/g, '_')}_${new Date().toISOString().slice(0, 10)}.pdf`;
        doc.save(fileName);
        
        showToast('PDF Export Successful', 'Professional report has been generated', 'success');
        
    } catch (error) {
        console.error('PDF Export Error:', error);
        showToast('Export Failed', 'Error generating PDF: ' + error.message, 'error');
    }
}
