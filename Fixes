Additional JavaScript Fix:

Find the ensureProperLayout() function (around line 5480) and REPLACE it:

```javascript
function ensureProperLayout() {
    // Force a reflow to fix any layout issues
    setTimeout(function() {
        const mainContent = document.querySelector('.main-content');
        const sidebar = document.querySelector('.sidebar');
        const flexContainer = document.querySelector('.d-flex');
        
        if (mainContent) {
            mainContent.style.opacity = '0.99';
            mainContent.style.padding = '0';
            mainContent.style.margin = '0';
            setTimeout(function() {
                mainContent.style.opacity = '1';
            }, 10);
        }
        
        if (flexContainer) {
            flexContainer.style.gap = '0';
        }
        
        if (sidebar) {
            sidebar.style.margin = '0';
            sidebar.style.padding = '0';
        }
        
        // Trigger window resize event to force any responsive adjustments
        window.dispatchEvent(new Event('resize'));
        
        // Scroll to top of page when changing sections
        window.scrollTo({ top: 0, behavior: 'smooth' });
        
        // Fix table scrolling
        fixTableScrolling();
        
        // Force layout recalculation
        fixLayout();
    }, 50);
}
```

Find the fixLayout() function (around line 5610) and REPLACE it:

```javascript
// Force layout recalculation
function fixLayout() {
    // Force reflow
    document.body.style.display = 'none';
    document.body.offsetHeight; // Force reflow
    document.body.style.display = '';
    
    // Ensure main content has correct width and no gaps
    const mainContent = document.querySelector('.main-content');
    const sidebar = document.querySelector('.sidebar');
    const flexContainer = document.querySelector('.d-flex');
    
    if (mainContent && sidebar && flexContainer) {
        const sidebarWidth = parseInt(getComputedStyle(document.documentElement)
            .getPropertyValue('--sidebar-width'));
        
        // Ensure no gap between sidebar and content
        flexContainer.style.gap = '0';
        mainContent.style.marginLeft = '0';
        mainContent.style.paddingLeft = '0';
        sidebar.style.marginRight = '0';
        sidebar.style.paddingRight = '0';
        
        // Set widths correctly
        mainContent.style.width = `calc(100% - ${sidebarWidth}px)`;
        mainContent.style.maxWidth = `calc(100% - ${sidebarWidth}px)`;
    }
}
```

