        const { jsPDF } = window.jspdf;
        
        // Get clean data - create a fresh copy without any DOM references
        const projects = JSON.parse(JSON.stringify(
            projectId === 'all' ? db.getProjects() : db.getProjects().filter(p => p.id === projectId)
        ));
        
        const assessments = JSON.parse(JSON.stringify(
            projectId === 'all' ? db.getAssessments() : db.getAssessments().filter(a => a.projectId === projectId)
