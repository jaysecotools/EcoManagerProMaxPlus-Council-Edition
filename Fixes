                    line2 += ` | Project: ${getProjectNameSafe(item.projectId)}`;
                }
                doc.text(line2, 30, yPos);
                yPos += 5;
                
                // Description if exists (truncated)
                if (item.description) {
                    const descText = toPlainString(item.description);
