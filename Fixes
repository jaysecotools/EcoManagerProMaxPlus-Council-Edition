Looking at your code, I can see the issue with demo weather data not loading. The problem is in the weatherConfig object at the top of your script. You have:

```javascript
const weatherConfig = {
    apiKey: 'YOUR_API_KEY_HERE', // <-- PASTE YOUR API KEY HERE
    baseUrl: 'https://api.weatherapi.com/v1',
    useProxy: false,
    fallbackToExample: true
};
```

But the API key is still set to the placeholder 'YOUR_API_KEY_HERE'. Additionally, your weather functions are checking weatherConfig.apiKey and comparing it to 'YOUR_API_KEY_HERE', which will fail.

Here's the fix - update the getWeatherByCoords function to properly check for demo mode:

```javascript
async function getWeatherByCoords(lat, lon) {
    // Check if we should use demo data
    const useDemoData = localStorage.getItem('useDemoData') !== 'false';
    const savedApiKey = localStorage.getItem('weatherApiKey');
    const hasValidApiKey = savedApiKey && savedApiKey !== '' && savedApiKey !== 'YOUR_API_KEY_HERE';
    
    if (!useDemoData && hasValidApiKey) {
        try {
            // Use the saved API key from localStorage
            const url = `https://api.weatherapi.com/v1/current.json?key=${savedApiKey}&q=${lat},${lon}&aqi=yes`;
            const response = await fetch(url);
            
            if (!response.ok) {
                throw new Error(`API Error: ${response.status}`);
            }
            
            const data = await response.json();
            
            // Also fetch forecast
            const forecastUrl = `https://api.weatherapi.com/v1/forecast.json?key=${savedApiKey}&q=${lat},${lon}&days=7&aqi=no`;
            const forecastResponse = await fetch(forecastUrl);
            
            if (forecastResponse.ok) {
                const forecastData = await forecastResponse.json();
                data.forecast = forecastData.forecast;
            }
            
            localStorage.setItem('lastWeatherData', JSON.stringify(data));
            localStorage.setItem('lastWeatherUpdate', new Date().toISOString());
            
            return data;
        } catch (error) {
            console.error('Weather API error:', error);
            showToast('Weather API', 'API call failed. Using demo data.', 'warning');
            return getDemoWeatherData(lat, lon);
        }
    } else {
        // Use demo data
        if (!useDemoData && !hasValidApiKey) {
            showToast('Weather API', 'Please enter a valid API key in Weather API Settings to see live data.', 'info');
        }
        return getDemoWeatherData(lat, lon);
    }
}
```

