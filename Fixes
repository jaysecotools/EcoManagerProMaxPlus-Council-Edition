    function fixCorruptedData() {
        try {
            let maintenance = JSON.parse(localStorage.getItem('maintenance') || '[]');
            let changed = false;
            
            for (let i = 0; i < maintenance.length; i++) {
                if (maintenance[i].activity) {
                    let original = maintenance[i].activity;
                    let fixed = original
                        .replace(/&#x27;/g, "'")
                        .replace(/&quot;/g, '"')
                        .replace(/&#x2F;/g, '/')
                        .replace(/&amp;/g, '&')
                        .replace(/&lt;/g, '<')
                        .replace(/&gt;/g, '>');
                    
                    if (fixed !== original) {
                        maintenance[i].activity = fixed;
                        changed = true;
                    }
                }
            }
            
            if (changed) {
                localStorage.setItem('maintenance', JSON.stringify(maintenance));
                alert('✓ Fixed ' + changed + ' corrupted maintenance items! The page will now refresh.');
                location.reload();
            } else {
                alert('No corrupted data found. Your data is clean!');
                // Hide the button
                document.querySelector('[onclick="fixCorruptedData()"]').style.display = 'none';
            }
        } catch(e) {
            alert('Error: ' + e.message);
        }
    }
```

