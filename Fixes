// Force layout recalculation
function fixLayout() {
    // Force reflow
    document.body.style.display = 'none';
    document.body.offsetHeight; // Force reflow
    document.body.style.display = '';
    
    // Ensure main content has correct width
    const mainContent = document.querySelector('.main-content');
    if (mainContent) {
        const sidebarWidth = parseInt(getComputedStyle(document.documentElement)
            .getPropertyValue('--sidebar-width'));
        mainContent.style.width = `calc(100% - ${sidebarWidth}px)`;
        mainContent.style.marginLeft = `${sidebarWidth}px`;
    }
}

// Call this after any navigation or window resize
