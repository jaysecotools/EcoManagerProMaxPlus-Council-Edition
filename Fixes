            projectId === 'all' ? db.getMaintenance() : db.getMaintenance().filter(m => m.projectId === projectId)
        ));
        
        // Helper function to safely convert any text to plain string
        function toPlainString(text) {
            if (text === null || text === undefined) return '';
            // Convert to string and remove any non-printable characters
            let result = String(text);
            // Remove control characters but keep basic punctuation
            result = result.replace(/[\x00-\x08\x0B\x0C\x0E-\x1F\x7F]/g, '');
            // Replace common problematic characters
            result = result.replace(/[&<>]/g, function(match) {
                if (match === '&') return 'and';
                if (match === '<') return '<';
                if (match === '>') return '>';
                return match;
            });
            return result.trim();
        }
        
        // Helper to safely get project name
        function getProjectNameSafe(id) {
            const project = projects.find(p => p.id === id);
            return project ? toPlainString(project.name) : 'Unknown Project';
        }
        
        // Helper to format date safely
        function formatDateSafe(dateString) {
            if (!dateString) return 'Not specified';
            try {
                const date = new Date(dateString);
                if (isNaN(date.getTime())) return toPlainString(dateString);
                return `${date.getDate().toString().padStart(2, '0')}/${(date.getMonth() + 1).toString().padStart(2, '0')}/${date.getFullYear()}`;
            } catch (e) {
                return toPlainString(dateString);
            }
        }
        
        // Separate maintenance into upcoming and completed
        const upcomingMaintenance = maintenance.filter(m => m.status !== 'completed');
        const completedMaintenance = maintenance.filter(m => m.status === 'completed');
        
        // Create PDF
        const doc = new jsPDF({
            unit: 'mm',
