// Enhanced weather functions with backend proxy pattern
async function getWeatherByCoords(lat, lon) {
    if (weatherConfig.useProxy) {
        try {
            // For demo, simulate API call with example data
            return simulateWeatherAPI(lat, lon);
        } catch (error) {
            console.error('Weather proxy error:', error);
            if (weatherConfig.fallbackToExample) {
                return showExampleWeatherData();
            }
            return null;
        }
    } else {
        console.warn('Direct API calls are disabled for security. Using example data.');
        return showExampleWeatherData();
    }
}

