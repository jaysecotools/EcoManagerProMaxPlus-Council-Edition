// ==================== MAP FUNCTIONS ====================
function initProjectMap() {
    const mapContainer = document.getElementById('projectMap');
    if (!mapContainer) return;
    if (projectMap) projectMap.remove();
    projectMap = L.map('projectMap').setView([-41.0521, 145.9061], 11);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '© OpenStreetMap contributors' }).addTo(projectMap);
    
    drawnItems = new L.FeatureGroup();
    projectMap.addLayer(drawnItems);
    const drawControl = new L.Control.Draw({ edit: { featureGroup: drawnItems }, draw: { polygon: { allowIntersection: false, showArea: true }, marker: true, polyline: false, circle: false, rectangle: false, circlemarker: false } });
    projectMap.addControl(drawControl);
    
    projectMap.on(L.Draw.Event.CREATED, function(e) {
        if (e.layerType === 'marker') {
            setProjectMarker(e.layer.getLatLng().lat, e.layer.getLng().lng);
        } else if (e.layerType === 'polygon') {
            if (currentPolygonLayer) drawnItems.removeLayer(currentPolygonLayer);
            currentPolygonLayer = e.layer;
            drawnItems.addLayer(currentPolygonLayer);
            const center = e.layer.getBounds().getCenter();
            setProjectMarker(center.lat, center.lng);
            showToast('Polygon Added', 'Project boundary saved', 'success');
        }
    });
    
    const lat = document.getElementById('projectLatitude')?.value;
    const lng = document.getElementById('projectLongitude')?.value;
    if (lat && lng) setProjectMarker(parseFloat(lat), parseFloat(lng));
    return projectMap;
}

function setProjectMarker(lat, lng) {
    const latInput = document.getElementById('projectLatitude');
    const lngInput = document.getElementById('projectLongitude');
    if (latInput) latInput.value = lat.toFixed(6);
    if (lngInput) lngInput.value = lng.toFixed(6);
    if (projectMarker) projectMap.removeLayer(projectMarker);
    projectMarker = L.marker([lat, lng]).addTo(projectMap).bindPopup('Project Location').openPopup();
    projectMap.setView([lat, lng], 12);
}

function clearProjectMarker() {
    if (projectMarker) projectMap.removeLayer(projectMarker);
    if (currentPolygonLayer) drawnItems.removeLayer(currentPolygonLayer);
    document.getElementById('projectLatitude').value = '';
    document.getElementById('projectLongitude').value = '';
    showToast('Location Cleared', 'Project location removed', 'info');
}

function useCurrentLocation() {
    if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(
            p => setProjectMarker(p.coords.latitude, p.coords.longitude),
            () => showToast('Location Error', 'Unable to retrieve location', 'error')
        );
    } else showToast('Location Error', 'Geolocation not supported', 'error');
}

