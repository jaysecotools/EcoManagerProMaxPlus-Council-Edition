Why this works:

The external functions (formatDateStr, getProjectNameSafe, and sanitizeText) are already defined outside exportToPDF, so they are available globally. By redefining them inside, you're creating a scope issue.

The corrected structure should be:

```javascript
// External functions (already defined)
function formatDateStr(dateString, format = 'full') { ... }
function getProjectNameSafe(projectId) { ... }
function sanitizeText(text) { ... }

function exportToPDF(projectId) {
    try {
        // NO internal function definitions here
        
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ ... });
        
        // Helper functions inside exportToPDF (these are fine)
        function addWrappedText(doc, text, x, y, maxWidth, lineHeight, fontStyle = 'normal') {
            // This will use the external sanitizeText
            let cleanedContent = sanitizeText(text);
            // ...
        }
        
        // ... rest of your code
    } catch (error) {
        // ...
    }
}
```

