/* Force weather widget visibility */
#weather .weather-widget {
    display: block !important;
    visibility: visible !important;
    min-height: 200px;
}

#weather .card {
    display: block !important;
    overflow: visible !important;
}

#weather .card-body {
    overflow: visible !important;
}

/* Ensure weather section is visible */
#weather.content-section {
    display: none;
}

#weather.content-section.active {
    display: block !important;
    min-height: 500px;
}

