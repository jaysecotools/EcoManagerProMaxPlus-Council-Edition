function getCleanMaintenanceData() {
    try {
        const rawData = localStorage.getItem('maintenance');
        if (!rawData) return [];
        
        // Parse and clean each item
        const items = JSON.parse(rawData);
        return items.map(item => ({
            id: String(item.id || ''),
            activity: String(item.activity || '').replace(/[^\x20-\x7E]/g, ''),
            type: String(item.type || 'other').replace(/[^\x20-\x7E]/g, ''),
            date: String(item.date || ''),
