function generateDemoForecast() {
    const days = [];
    const today = new Date();
    const baseTemp = 18;
    
    for (let i = 0; i < 7; i++) {
        const date = new Date(today);
        date.setDate(today.getDate() + i);
        
        const dayTemp = baseTemp + Math.sin(i * Math.PI / 3) * 3;
        const nightTemp = dayTemp - 5 + Math.random() * 2;
        
        days.push({
            date: date.toISOString().split('T')[0],
            day: {
                maxtemp_c: Math.round(dayTemp + 2),
                mintemp_c: Math.round(nightTemp),
                avgtemp_c: Math.round((dayTemp + nightTemp) / 2),
                condition: {
                    text: getRandomWeatherCondition(),
                    code: getRandomWeatherCode()
                }
            }
        });
    }
    return { forecastday: days };
}
```

