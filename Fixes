function repairCorruptedData() {
    console.log("Repairing corrupted maintenance data...");
    var maintenance = db.getMaintenance();
    var fixed = false;
    
    for (var i = 0; i < maintenance.length; i++) {
        var item = maintenance[i];
        if (item.activity && item.activity.indexOf('&') !== -1) {
            // Try to decode HTML entities
            var temp = document.createElement('textarea');
            temp.innerHTML = item.activity;
            var decoded = temp.value;
            
            if (decoded !== item.activity) {
                console.log("Fixed: " + item.activity + " -> " + decoded);
                item.activity = decoded;
                fixed = true;
            }
        }
    }
    
    if (fixed) {
        localStorage.setItem('maintenance', JSON.stringify(maintenance));
        console.log("Data repair complete!");
        showToast("Data Repaired", "Fixed corrupted maintenance activity names", "success");
        location.reload(); // Reload to see the fix
    } else {
        console.log("No corrupted data found");
    }
}
```

