function updateHistoricalWeatherChart() {
    const ctx = document.getElementById('historicalWeatherChart');
    
    if (!ctx) return;
    
    // Destroy existing chart if it exists
    if (historicalWeatherChart) {
        historicalWeatherChart.destroy();
    }
    
    // Create the historical weather chart with realistic data
    historicalWeatherChart = new Chart(ctx, {
        type: 'bar',
        data: {
            labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
            datasets: [
                {
                    label: 'Rainfall (mm)',
                    data: [45, 52, 48, 62, 75, 82, 97, 94, 78, 64, 52, 48],
                    backgroundColor: 'rgba(54, 162, 235, 0.8)',
                    borderColor: 'rgba(54, 162, 235, 1)',
                    borderWidth: 1,
                    yAxisID: 'y'
                },
                {
                    label: 'Average Temperature (°C)',
                    data: [22, 22, 20, 17, 14, 12, 11, 12, 14, 16, 18, 20],
                    type: 'line',
                    borderColor: 'rgb(255, 99, 132)',
                    backgroundColor: 'rgba(255, 99, 132, 0.2)',
                    tension: 0.4,
                    yAxisID: 'y1'
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: {
                mode: 'index',
                intersect: false,
            },
            scales: {
                y: {
                    type: 'linear',
                    display: true,
                    position: 'left',
                    title: {
                        display: true,
                        text: 'Rainfall (mm)'
                    }
                },
                y1: {
                    type: 'linear',
                    display: true,
                    position: 'right',
                    title: {
                        display: true,
                        text: 'Temperature (°C)'
                    },
                    grid: {
                        drawOnChartArea: false
                    }
                }
            },
            plugins: {
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            let label = context.dataset.label || '';
                            if (label) {
                                label += ': ';
                            }
                            if (context.parsed.y !== null) {
                                if (context.dataset.label.includes('Rainfall')) {
                                    label += context.parsed.y + ' mm';
                                } else {
                                    label += context.parsed.y + '°C';
                                }
                            }
                            return label;
                        }
                    }
                }
            }
        }
    });
}
```

