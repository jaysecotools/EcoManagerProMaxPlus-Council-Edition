The Guaranteed Fix - Add onclick directly to HTML

Step 1: Add this function at the very top of your script section:

```javascript
// Simple navigation function - works everywhere
function goToSection(sectionId) {
    console.log('Navigating to:', sectionId);
    
    // Update sidebar active states
    var links = document.querySelectorAll('.sidebar .nav-link');
    for (var i = 0; i < links.length; i++) {
        links[i].classList.remove('active');
        if (links[i].getAttribute('data-target') === sectionId) {
            links[i].classList.add('active');
        }
    }
    
    // Hide all sections
    var sections = document.querySelectorAll('.content-section');
    for (var i = 0; i < sections.length; i++) {
        sections[i].classList.remove('active');
    }
    
    // Show target section
    var targetSection = document.getElementById(sectionId);
    if (targetSection) {
        targetSection.classList.add('active');
    }
    
    // Load section data
    if (sectionId === 'dashboard') loadDashboard();
    if (sectionId === 'projects') { loadProjects(); setTimeout(initProjectMap, 100); }
    if (sectionId === 'assessments') loadAssessments();
    if (sectionId === 'species') loadSpecies();
    if (sectionId === 'maintenance') loadMaintenance();
    if (sectionId === 'charts') loadAnalyticsCharts();
    if (sectionId === 'data') loadDataSummary();
    if (sectionId === 'weather') loadWeatherData();
    
    return false;
}
```

