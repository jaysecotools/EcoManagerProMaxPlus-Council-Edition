                doc.setFontSize(10);
                doc.setFont(undefined, 'normal');
                doc.setTextColor(40, 167, 69);
                
                // Build the activity string safely
                const checkmark = String.fromCharCode(10003); // ✓ character
                const activityName = toPlainString(item.activity || 'Unnamed Activity');
