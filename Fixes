};

// ==================== INITIALIZATION ====================
function initApp() {
    db.init();
    setupFormHandlers();
    setupViewToggle();
    loadDashboard();
    loadProjects();
    loadAssessments();
    loadSpecies();
    loadMaintenance();
    loadDataSummary();
    initApiKeyManagement();
    
    document.querySelectorAll('.sidebar .nav-link[data-target]').forEach(link => {
        link.addEventListener('click', (e) => { e.preventDefault(); navigateTo(link.getAttribute('data-target')); });
    });
    document.querySelectorAll('.quick-action-btn').forEach(btn => {
        btn.addEventListener('click', () => navigateTo(btn.getAttribute('data-target')));
    });
    
    window.addEventListener('resize', fixMobileLayout);
    fixMobileLayout();
    AOS.init({ duration: 800, once: true });
}

function initApiKeyManagement() {
    const savedKey = localStorage.getItem('weatherApiKey');
    const useDemo = localStorage.getItem('useDemoData') !== 'false';
    const demoCheckbox = document.getElementById('useDemoData');
    const apiInput = document.getElementById('apiKeyInput');
    if (demoCheckbox) demoCheckbox.checked = useDemo;
    if (apiInput) apiInput.disabled = useDemo;
    if (savedKey && !useDemo && apiInput) apiInput.value = '••••••••••••••••';
}

document.addEventListener('DOMContentLoaded', initApp);

window.navigateTo = navigateTo;
window.deleteAssessment = deleteAssessment;
window.deleteSpecies = deleteSpecies;
window.deleteMaintenance = deleteMaintenance;
window.completeMaintenance = completeMaintenance;
window.showProjectInModal = showProjectInModal;
window.userOnboarding = userOnboarding;
window.formBuilder = formBuilder;
window.editProject = editProject;
window.deleteProjectItem = deleteProjectItem;
</script>
