        doc.setFont(undefined, 'bold');
        doc.setTextColor(44, 85, 48);
        doc.text('Upcoming Scheduled Tasks', 20, yPos);
        yPos += 10;
        
        if (upcomingMaintenance.length === 0) {
            doc.setFontSize(10);
            doc.setFont(undefined, 'italic');
            doc.setTextColor(120, 120, 120);
            doc.text('No upcoming maintenance tasks', 25, yPos);
            yPos += 10;
        } else {
            for (let i = 0; i < Math.min(upcomingMaintenance.length, 15); i++) {
                const item = upcomingMaintenance[i];
                
                // Check if we need a new page
                if (yPos > 270) {
                    doc.addPage();
                    yPos = 20;
                }
                
                // Activity name
                doc.setFontSize(11);
                doc.setFont(undefined, 'bold');
                doc.setTextColor(0, 0, 0);
                const activityText = toPlainString(item.activity || 'Unnamed Activity');
                doc.text(`• ${activityText.substring(0, 60)}`, 25, yPos);
