function getDemoWeatherData(lat, lon) {
    console.log("Generating demo weather data for:", lat, lon);
    
    // Get location name from coordinates or use default
    let locationName = getLocationNameFromCoords(lat, lon);
    
    // Return properly structured weather data
    return {
