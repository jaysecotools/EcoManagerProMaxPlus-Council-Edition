    function ensureProperLayout() {
        // Force a reflow to fix any layout issues
        setTimeout(function() {
            const mainContent = document.querySelector('.main-content');
            if (mainContent) {
                mainContent.style.opacity = '0.99';
                setTimeout(function() {
                    mainContent.style.opacity = '1';
                }, 10);
            }
            
            // Trigger window resize event to force any responsive adjustments
            window.dispatchEvent(new Event('resize'));
            
            // Scroll to top of page when changing sections
            window.scrollTo({ top: 0, behavior: 'smooth' });
            
            // ADD THIS LINE - Fix table scrolling
            fixTableScrolling();
        }, 50);
    }
