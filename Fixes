function exportToPDF(projectId) {
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF({
        unit: 'mm',
        format: 'a4',
        orientation: 'portrait'
    });
    
    // Helper function to add wrapped text
    function addWrappedText(doc, text, x, y, maxWidth, lineHeight) {
        if (!text) return y;
        const lines = doc.splitTextToSize(text, maxWidth);
        doc.text(lines, x, y);
        return y + (lines.length * lineHeight);
    }
    
    // Helper function to add new page if needed
    function checkAndAddPage(doc, currentY, requiredSpace) {
        if (currentY + requiredSpace > 280) {
            doc.addPage();
            return 20;
        }
        return currentY;
    }
    
    // Add title
    doc.setFontSize(20);
    doc.text('EcoManager Pro Report', 105, 15, { align: 'center' });
    doc.setFontSize(10);
    doc.text(`Generated on: ${new Date().toLocaleDateString()}`, 105, 22, { align: 'center' });
    doc.text(`Generated by: ${currentUser.role}`, 105, 28, { align: 'center' });
    
    let yPosition = 35;
    
    // Project information with wrapped text
    const projects = projectId === 'all' ? db.getProjects() : db.getProjects().filter(p => p.id === projectId);
    
    if (projects.length > 0) {
        doc.setFontSize(14);
        doc.setFont(undefined, 'bold');
        doc.text('Projects', 14, yPosition);
        yPosition += 10;
        
        projects.forEach((project, index) => {
            // Check if we need a new page
            yPosition = checkAndAddPage(doc, yPosition, 60);
            
            doc.setFontSize(11);
            doc.setFont(undefined, 'bold');
            doc.text(`${index + 1}. ${project.name.substring(0, 60)}`, 14, yPosition);
            yPosition += 7;
            
            doc.setFont(undefined, 'normal');
            doc.setFontSize(10);
            
            // Status and progress on same line
            doc.text(`Status: ${project.status} | Progress: ${project.progress || 0}% | Start Date: ${formatDate(project.startDate)}`, 14, yPosition);
            yPosition += 7;
            
            // Budget and location
            let locationText = '';
            if (project.latitude && project.longitude) {
                locationText = ` | Location: ${project.latitude.toFixed(4)}, ${project.longitude.toFixed(4)}`;
            }
            doc.text(`Budget: $${(project.budget || 0).toLocaleString()}${locationText}`, 14, yPosition);
            yPosition += 7;
            
            // Description with wrapping
            if (project.description) {
                yPosition = addWrappedText(doc, `Description: ${project.description}`, 14, yPosition, 180, 5);
                yPosition += 3;
            } else {
                yPosition += 3;
            }
            
            yPosition += 5;
        });
    }
    
    // Assessments section
    const assessments = projectId === 'all' ? db.getAssessments() : db.getAssessments().filter(a => a.projectId === projectId);
    
    if (assessments.length > 0) {
        yPosition = checkAndAddPage(doc, yPosition, 50);
        
        doc.setFontSize(14);
        doc.setFont(undefined, 'bold');
        doc.text('Assessments', 14, yPosition);
        yPosition += 10;
        
        assessments.forEach((assessment, index) => {
            yPosition = checkAndAddPage(doc, yPosition, 40);
            
            doc.setFontSize(10);
            doc.setFont(undefined, 'bold');
            doc.text(`${index + 1}. ${formatDate(assessment.date)} - ${assessment.assessor.substring(0, 40)}`, 14, yPosition);
            yPosition += 6;
            
            doc.setFont(undefined, 'normal');
            doc.text(`Health Status: ${assessment.health || 'Not rated'} | Project: ${getProjectName(assessment.projectId)}`, 14, yPosition);
            yPosition += 6;
            
            // Description with wrapping
            if (assessment.description) {
                yPosition = addWrappedText(doc, `Notes: ${assessment.description}`, 14, yPosition, 180, 5);
                yPosition += 3;
            }
            
            yPosition += 5;
        });
    }
    
    // Species section
    const species = projectId === 'all' ? db.getSpecies() : db.getSpecies().filter(s => s.projectId === projectId);
    
    if (species.length > 0) {
        yPosition = checkAndAddPage(doc, yPosition, 40);
        
        doc.setFontSize(14);
        doc.setFont(undefined, 'bold');
        doc.text('Species', 14, yPosition);
        yPosition += 10;
        
        // Use table format for species to save space
        const speciesData = species.map(s => ({
            name: s.name.substring(0, 25),
            type: s.type,
            status: s.status
        }));
        
        // Table headers
        doc.setFillColor(200, 200, 200);
        doc.rect(14, yPosition, 50, 7, 'F');
        doc.rect(64, yPosition, 30, 7, 'F');
        doc.rect(94, yPosition, 30, 7, 'F');
        
        doc.setFont(undefined, 'bold');
        doc.text('Species Name', 15, yPosition + 5);
        doc.text('Type', 65, yPosition + 5);
        doc.text('Status', 95, yPosition + 5);
        yPosition += 7;
        
        doc.setFont(undefined, 'normal');
        speciesData.forEach((s, idx) => {
            if (yPosition > 270) {
                doc.addPage();
                yPosition = 20;
            }
            doc.text(s.name, 15, yPosition + 4);
            doc.text(s.type, 65, yPosition + 4);
            doc.text(s.status, 95, yPosition + 4);
            yPosition += 6;
        });
        
        yPosition += 5;
    }
    
    // Maintenance section
    const maintenance = projectId === 'all' ? db.getMaintenance() : db.getMaintenance().filter(m => m.projectId === projectId);
    
    if (maintenance.length > 0) {
        yPosition = checkAndAddPage(doc, yPosition, 40);
        
        doc.setFontSize(14);
        doc.setFont(undefined, 'bold');
        doc.text('Maintenance Activities', 14, yPosition);
        yPosition += 10;
        
        maintenance.forEach((item, index) => {
            yPosition = checkAndAddPage(doc, yPosition, 35);
            
            doc.setFontSize(10);
            doc.setFont(undefined, 'bold');
            doc.text(`${index + 1}. ${item.activity.substring(0, 50)}`, 14, yPosition);
            yPosition += 6;
            
            doc.setFont(undefined, 'normal');
            doc.text(`Type: ${item.type} | Date: ${formatDate(item.date)} | Priority: ${item.priority} | Status: ${item.status}`, 14, yPosition);
            yPosition += 6;
            
            // Description with wrapping
            if (item.description) {
                yPosition = addWrappedText(doc, `Details: ${item.description}`, 14, yPosition, 180, 5);
                yPosition += 3;
            }
            
            yPosition += 5;
        });
    }
    
    // Add summary page if there's data
    if (projects.length > 0 || assessments.length > 0 || species.length > 0 || maintenance.length > 0) {
        doc.addPage();
        doc.setFontSize(16);
        doc.setFont(undefined, 'bold');
        doc.text('Report Summary', 105, 20, { align: 'center' });
        
        doc.setFontSize(12);
        doc.setFont(undefined, 'normal');
        
        let summaryY = 35;
        doc.text(`Total Projects: ${projects.length}`, 14, summaryY); summaryY += 10;
        doc.text(`Total Assessments: ${assessments.length}`, 14, summaryY); summaryY += 10;
        doc.text(`Total Species: ${species.length}`, 14, summaryY); summaryY += 10;
        doc.text(`Total Maintenance Tasks: ${maintenance.length}`, 14, summaryY); summaryY += 15;
        
        // Add health status breakdown if assessments exist
        if (assessments.length > 0) {
            const healthCounts = {
                excellent: assessments.filter(a => a.health === 'excellent').length,
                good: assessments.filter(a => a.health === 'good').length,
                fair: assessments.filter(a => a.health === 'fair').length,
                poor: assessments.filter(a => a.health === 'poor').length,
                degraded: assessments.filter(a => a.health === 'degraded').length
            };
            
            doc.text('Health Status Summary:', 14, summaryY); summaryY += 8;
            doc.text(`  • Excellent: ${healthCounts.excellent}`, 20, summaryY); summaryY += 6;
            doc.text(`  • Good: ${healthCounts.good}`, 20, summaryY); summaryY += 6;
            doc.text(`  • Fair: ${healthCounts.fair}`, 20, summaryY); summaryY += 6;
            doc.text(`  • Poor: ${healthCounts.poor}`, 20, summaryY); summaryY += 6;
            doc.text(`  • Degraded: ${healthCounts.degraded}`, 20, summaryY);
        }
        
        // Add footer
        const pageCount = doc.internal.getNumberOfPages();
        for (let i = 1; i <= pageCount; i++) {
            doc.setPage(i);
            doc.setFontSize(8);
            doc.text(`Page ${i} of ${pageCount}`, 105, 290, { align: 'center' });
            doc.text('EcoManager Pro - Council Ecosystem Management System', 105, 285, { align: 'center' });
        }
    }
    
    // Save the PDF
    const fileName = `ecomanager-report-${projectId === 'all' ? 'all-projects' : 'project-' + projectId}-${new Date().toISOString().slice(0, 10)}.pdf`;
    doc.save(fileName);
    
    auditLog.log('EXPORT_DATA', {
        format: 'pdf',
        projectId: projectId
    });
    
    showToast('PDF Export Successful', 'PDF report has been generated successfully', 'success');
}
