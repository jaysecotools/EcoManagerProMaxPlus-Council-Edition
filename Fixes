<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>EcoManager Pro | Complete Ecosystem Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet-draw@1.0.4/dist/leaflet.draw.css"/>
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intro.js@4.3.0/minified/introjs.min.css">
    <script src="https://cdn.jsdelivr.net/npm/intro.js@4.3.0/minified/intro.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@turf/turf@6/turf.min.js"></script>
    <style>
        :root {
            --primary: #2c5530;
            --secondary: #4a7c59;
            --accent: #3a8a5f;
            --accent-light: #4da675;
            --success: #28a745;
            --warning: #ffc107;
            --danger: #dc3545;
            --light: #f8f9fa;
            --dark: #1e2b1e;
            --sidebar-width: 280px;
            --transition: all 0.3s ease;
            --info: #17a2b8;
        }

        * { box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fa;
            color: #2c3e50;
            line-height: 1.6;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        .sidebar {
            flex-shrink: 0;
            width: var(--sidebar-width);
            position: relative;
            min-height: 100vh;
            background: linear-gradient(to bottom, var(--primary), var(--secondary));
            color: white;
            box-shadow: 3px 0 15px rgba(0, 0, 0, 0.1);
            transition: var(--transition);
        }

        .sidebar .nav-link {
            color: rgba(255, 255, 255, 0.85);
            margin-bottom: 5px;
            border-radius: 8px;
            padding: 12px 15px;
            transition: var(--transition);
            font-weight: 500;
            cursor: pointer;
        }

        .sidebar .nav-link:hover, .sidebar .nav-link.active {
            color: white;
            background-color: rgba(255, 255, 255, 0.1);
            transform: translateX(5px);
        }

        .sidebar .nav-link i {
            margin-right: 12px;
            font-size: 1.2rem;
            width: 24px;
            text-align: center;
        }

        .logo {
            font-weight: 700;
            padding: 20px 25px;
            font-size: 1.4rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            align-items: center;
        }

        .logo i { margin-right: 10px; color: var(--accent-light); }

        .main-content {
            flex: 1;
            padding: 20px;
            transition: var(--transition);
            min-height: 100vh;
            width: 100%;
            overflow-x: hidden;
        }

        .d-flex { display: flex !important; align-items: flex-start; width: 100%; gap: 0 !important; }

        .card {
            margin-bottom: 25px;
            border: none;
            border-radius: 12px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
            transition: var(--transition);
        }

        .card:hover { box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12); transform: translateY(-5px); }

        .card-header {
            background-color: white;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            padding: 15px 20px;
            font-weight: 600;
            color: var(--primary);
            border-radius: 12px 12px 0 0 !important;
        }

        .stat-card {
            text-align: center;
            padding: 20px;
            border-left: 4px solid var(--accent);
            cursor: pointer;
            transition: var(--transition);
        }

        .stat-card:hover { transform: translateY(-5px); }
        .stat-card h3 { font-size: 2.2rem; font-weight: 700; margin: 10px 0; }

        .table-responsive {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            width: 100%;
        }

        .table { min-width: 800px; width: 100%; margin-bottom: 0; }
        .table th { font-weight: 600; color: var(--primary); white-space: nowrap; }
        .table td { white-space: nowrap; }

        .content-section { display: none; animation: fadeIn 0.5s ease; width: 100%; }
        .content-section.active { display: block; }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .quick-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 20px;
        }

        .quick-action-btn {
            flex: 1;
            min-width: 150px;
            text-align: center;
            padding: 15px;
            border-radius: 10px;
            background: white;
            box-shadow: 0 3px 10px rgba(0,0,0,0.08);
            transition: var(--transition);
            cursor: pointer;
        }

        .quick-action-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        .quick-action-btn i { font-size: 1.5rem; margin-bottom: 10px; color: var(--accent); }

        .weather-widget {
            background: linear-gradient(135deg, #67b26f, #4ca2cd);
            color: white;
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 20px;
        }

        .map-container { height: 300px; border-radius: 8px; overflow: hidden; margin-bottom: 15px; width: 100%; }
        .chart-container { position: relative; height: 300px; margin-bottom: 20px; width: 100%; }

        #login-screen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: opacity 0.3s ease;
        }

        .login-container {
            background: white;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.2);
            width: 100%;
            max-width: 400px;
        }

        .toast-container { position: fixed; top: 20px; right: 20px; z-index: 1100; }
        .toast-header.bg-danger { background-color: #dc3545 !important; }
        .toast-header.bg-warning { background-color: #ffc107 !important; }
        .toast-header.bg-info { background-color: #17a2b8 !important; }

        .maintenance-item {
            border-left: 4px solid #6c757d;
            padding-left: 15px;
            margin-bottom: 15px;
            transition: var(--transition);
        }

        .maintenance-item:hover { background-color: rgba(0, 0, 0, 0.02); }
        .maintenance-pending { border-left-color: var(--warning); }
        .maintenance-completed { border-left-color: var(--success); }
        .maintenance-overdue { border-left-color: var(--danger); }

        .list-view, .calendar-view { display: none; }
        .list-view.active, .calendar-view.active { display: block; }

        .section-header {
            background: linear-gradient(135deg, rgba(44, 85, 48, 0.03), rgba(74, 124, 89, 0.05));
            padding: 1.25rem 1.5rem;
            border-radius: 16px;
            margin-bottom: 1.75rem;
            border: 1px solid rgba(44, 85, 48, 0.1);
        }

        .section-header h2 {
            font-size: 1.6rem;
            font-weight: 700;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            margin-bottom: 0.35rem;
        }

        .form-control, .form-select {
            padding: 12px 15px;
            border-radius: 8px;
            border: 1px solid #ddd;
            transition: var(--transition);
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 0.25rem rgba(58, 138, 95, 0.25);
        }

        .btn {
            border-radius: 8px;
            padding: 10px 20px;
            font-weight: 500;
            transition: var(--transition);
        }

        .btn-primary { background-color: var(--accent); border-color: var(--accent); }
        .btn-primary:hover { background-color: var(--accent-light); border-color: var(--accent-light); transform: translateY(-2px); }

        .badge { padding: 8px 12px; border-radius: 20px; font-weight: 500; }

        .risk-matrix {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 2px;
            margin: 15px 0;
        }

        .risk-cell {
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
            font-weight: bold;
        }

        .risk-low { background-color: #d4edda; color: #155724; }
        .risk-medium { background-color: #fff3cd; color: #856404; }
        .risk-high { background-color: #f8d7da; color: #721c24; }

        .progress { height: 10px; border-radius: 5px; }
        .map-preview { height: 150px; border-radius: 6px; overflow: hidden; cursor: pointer; background-color: #f8f9fa; display: flex; align-items: center; justify-content: center; }
        .document-item { display: flex; align-items: center; padding: 10px; border-bottom: 1px solid #eee; }
        .document-icon { font-size: 1.5rem; margin-right: 15px; color: var(--primary); }
        .empty-state { text-align: center; padding: 40px; color: #6c757d; }
        .empty-state i { font-size: 3rem; margin-bottom: 15px; opacity: 0.5; }
        .legend-item { display: inline-flex; align-items: center; margin-right: 15px; }
        .legend-color { width: 20px; height: 20px; border-radius: 4px; margin-right: 5px; }
        .approval-badge { cursor: pointer; }
        
        @media (max-width: 992px) {
            .sidebar { width: 70px; overflow-x: hidden; }
            .sidebar .logo span, .sidebar .nav-link span { display: none; }
            .sidebar .nav-link i { margin-right: 0; font-size: 1.4rem; }
            .sidebar:hover { width: var(--sidebar-width); position: absolute; z-index: 1001; }
            .sidebar:hover .logo span, .sidebar:hover .nav-link span { display: inline; }
            .sidebar:hover .nav-link i { margin-right: 12px; }
        }

        @media (max-width: 768px) {
            .container-fluid > .d-flex { flex-direction: column !important; }
            .sidebar {
                position: fixed !important;
                bottom: 0 !important;
                top: auto !important;
                width: 100% !important;
                height: auto !important;
                min-height: auto !important;
                z-index: 1000 !important;
                border-radius: 16px 16px 0 0 !important;
                padding: 8px 4px !important;
                left: 0 !important;
                right: 0 !important;
            }
            .sidebar .logo { display: none !important; }
            .sidebar .nav {
                display: flex !important;
                flex-direction: row !important;
                justify-content: space-around !important;
                padding: 0 !important;
                margin: 0 !important;
                gap: 4px !important;
                overflow-x: auto;
            }
            .sidebar .nav-item { flex: 1; text-align: center; }
            .sidebar .nav-link {
                flex-direction: column !important;
                padding: 8px 4px !important;
                font-size: 0.7rem !important;
                transform: none !important;
            }
            .sidebar .nav-link i { font-size: 1.3rem !important; margin: 0 0 4px 0 !important; display: block !important; }
            .sidebar .nav-link span { display: block !important; font-size: 0.6rem !important; }
            .main-content { width: 100% !important; margin: 0 !important; padding: 15px !important; padding-bottom: 85px !important; overflow-x: hidden; }
        }
    </style>
</head>
<body>
<div id="login-screen">
    <div class="login-container">
        <div class="text-center mb-4">
            <i class="bi bi-tree-fill" style="font-size: 3rem; color: var(--primary);"></i>
            <h2 class="mt-3">EcoManager Pro</h2>
            <p class="text-muted">Council Ecosystem Management System</p>
        </div>
        <div class="mb-4">
            <label class="form-label">Select User Role:</label>
            <select class="form-select" id="userRole">
                <option value="viewer">Viewer (Read Only)</option>
                <option value="staff">Field Staff</option>
                <option value="manager">Project Manager</option>
                <option value="admin">System Administrator</option>
            </select>
        </div>
        <div class="mb-4">
            <label class="form-label">Password (demo):</label>
            <input type="password" class="form-control" id="demoPassword" value="council123">
        </div>
        <button class="btn btn-primary w-100 mb-3" onclick="window.login()"><i class="bi bi-box-arrow-in-right"></i> Enter System</button>
        <div class="text-center"><small class="text-muted">Version 2.0 • Complete Edition</small></div>
    </div>
</div>

<div class="toast-container">
    <div id="liveToast" class="toast" role="alert">
        <div class="toast-header">
            <i class="bi bi-check-circle-fill text-success me-2"></i>
            <strong class="me-auto" id="toast-title">Notification</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
        </div>
        <div class="toast-body" id="toast-message"></div>
    </div>
</div>

<div class="container-fluid p-0">
    <div class="d-flex">
        <div class="sidebar">
            <div class="logo"><i class="bi bi-tree-fill"></i><span>EcoManager Pro</span></div>
            <div class="p-3">
                <ul class="nav flex-column">
                    <li class="nav-item"><a class="nav-link active" data-target="dashboard"><i class="bi bi-speedometer2"></i> <span>Dashboard</span></a></li>
                    <li class="nav-item"><a class="nav-link" data-target="projects"><i class="bi bi-folder"></i> <span>Projects</span></a></li>
                    <li class="nav-item"><a class="nav-link" data-target="assessments"><i class="bi bi-clipboard-check"></i> <span>Assessments</span></a></li>
                    <li class="nav-item"><a class="nav-link" data-target="species"><i class="bi bi-tree"></i> <span>Species</span></a></li>
                    <li class="nav-item"><a class="nav-link" data-target="maintenance"><i class="bi bi-tools"></i> <span>Maintenance</span></a></li>
                    <li class="nav-item"><a class="nav-link" data-target="charts"><i class="bi bi-bar-chart"></i> <span>Analytics</span></a></li>
                    <li class="nav-item"><a class="nav-link" data-target="data"><i class="bi bi-database"></i> <span>Data</span></a></li>
                    <li class="nav-item"><a class="nav-link" data-target="weather"><i class="bi bi-cloud-sun"></i> <span>Weather</span></a></li>
                    <li class="nav-item"><a class="nav-link" data-target="userguide"><i class="bi bi-question-circle"></i> <span>User Guide</span></a></li>
                    <li class="nav-item mt-4"><div class="nav-link text-center"><small class="text-white-50">Logged in as:</small><div id="currentUserRole" class="badge bg-light text-dark mt-1">Viewer</div></div></li>
                    <li class="nav-item"><a class="nav-link text-danger" onclick="window.logout()"><i class="bi bi-box-arrow-right"></i> <span>Logout</span></a></li>
                </ul>
            </div>
        </div>

        <div class="main-content">
            <!-- DASHBOARD SECTION -->
            <div id="dashboard" class="content-section active">
                <div class="section-header">
                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                        <div><h2><i class="bi bi-speedometer2"></i> Dashboard</h2><p class="text-muted">Overview of your ecosystem management activities</p></div>
                        <button class="btn btn-outline-primary btn-sm" onclick="window.userOnboarding.showTour()"><i class="bi bi-info-circle"></i> Take Tour</button>
                    </div>
                </div>
                <div class="quick-actions">
                    <div class="quick-action-btn" data-target="projects"><i class="bi bi-plus-circle"></i><h6>New Project</h6></div>
                    <div class="quick-action-btn" data-target="assessments"><i class="bi bi-clipboard-plus"></i><h6>New Assessment</h6></div>
                    <div class="quick-action-btn" data-target="species"><i class="bi bi-plus-square"></i><h6>Add Species</h6></div>
                    <div class="quick-action-btn" data-target="maintenance"><i class="bi bi-tools"></i><h6>Schedule Maintenance</h6></div>
                </div>
                <div class="row">
                    <div class="col-md-3 col-sm-6"><div class="card stat-card" onclick="window.navigateTo('projects')"><div class="card-body"><h5 class="card-title">Projects</h5><h3 id="projects-count" class="text-primary">0</h3><p class="text-muted mb-0">Active initiatives</p></div></div></div>
                    <div class="col-md-3 col-sm-6"><div class="card stat-card" onclick="window.navigateTo('assessments')"><div class="card-body"><h5 class="card-title">Assessments</h5><h3 id="assessments-count" class="text-info">0</h3><p class="text-muted mb-0">Surveys completed</p></div></div></div>
                    <div class="col-md-3 col-sm-6"><div class="card stat-card" onclick="window.navigateTo('species')"><div class="card-body"><h5 class="card-title">Species</h5><h3 id="species-count" class="text-success">0</h3><p class="text-muted mb-0">Tracked species</p></div></div></div>
                    <div class="col-md-3 col-sm-6"><div class="card stat-card" onclick="window.navigateTo('maintenance')"><div class="card-body"><h5 class="card-title">Maintenance</h5><h3 id="maintenance-count" class="text-warning">0</h3><p class="text-muted mb-0">Scheduled tasks</p></div></div></div>
                </div>
                <div class="row mt-4">
                    <div class="col-md-8">
                        <div class="card">
                            <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
                                <h5 class="card-title mb-0">Ecosystem Health Overview</h5>
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">Last 6 Months</button>
                                    <ul class="dropdown-menu"><li><a class="dropdown-item" data-range="3">Last 3 Months</a></li><li><a class="dropdown-item" data-range="6">Last 6 Months</a></li><li><a class="dropdown-item" data-range="12">Last Year</a></li></ul>
                                </div>
                            </div>
                            <div class="card-body"><div class="chart-container"><canvas id="healthTrendChart"></canvas></div><div id="chartLegend" class="mt-2 text-center"></div></div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card"><div class="card-header"><h5 class="card-title mb-0">Project Status</h5></div><div class="card-body"><div class="chart-container"><canvas id="projectStatusChart"></canvas></div></div></div>
                    </div>
                </div>
                <div class="row mt-4">
                    <div class="col-md-6"><div class="card"><div class="card-header"><h5 class="card-title mb-0">Recent Activities</h5></div><div class="card-body"><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Date</th><th>Type</th><th>Description</th><th>Project</th><th>Status</th></tr></thead><tbody id="recent-activities"></tbody></table></div></div></div></div>
                    <div class="col-md-6"><div class="card"><div class="card-header"><h5 class="card-title mb-0">Upcoming Maintenance</h5></div><div class="card-body"><div id="upcoming-maintenance"></div></div></div></div>
                </div>
            </div>

            <!-- PROJECTS SECTION -->
            <div id="projects" class="content-section">
                <div class="section-header"><h2><i class="bi bi-folder"></i> Projects</h2><p class="text-muted">Manage your ecosystem restoration projects</p></div>
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center flex-wrap"><h5 class="card-title mb-0">Project List</h5><div class="mt-2 mt-md-0"><input type="text" class="form-control form-control-sm" id="projectSearch" placeholder="Search projects..." style="width: 200px;"></div></div>
                    <div class="card-body"><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Name</th><th>Code</th><th>Status</th><th>Progress</th><th>Start Date</th><th>Budget</th><th>Approval</th><th>Actions</th></thead><tbody id="projects-table"></tbody></table></div></div>
                </div>
                <div class="card mt-4">
                    <div class="card-header"><h5 class="card-title mb-0">Add/Edit Project</h5></div>
                    <div class="card-body">
                        <form id="projectForm">
                            <input type="hidden" id="editProjectId">
                            <div class="row">
                                <div class="col-md-6"><div class="mb-3"><label class="form-label">Project Name *</label><input type="text" class="form-control" id="projectName" required></div></div>
                                <div class="col-md-6"><div class="mb-3"><label class="form-label">Project Code</label><input type="text" class="form-control" id="projectCode"></div></div>
                            </div>
                            <div class="row">
                                <div class="col-md-6"><div class="mb-3"><label class="form-label">Start Date *</label><input type="date" class="form-control" id="projectStartDate" required></div></div>
                                <div class="col-md-6"><div class="mb-3"><label class="form-label">Status *</label><select class="form-select" id="projectStatus" required><option value="planning">Planning</option><option value="active">Active</option><option value="on-hold">On Hold</option><option value="completed">Completed</option></select></div></div>
                            </div>
                            <div class="mb-3"><label class="form-label">Progress (%)</label><input type="range" class="form-range" id="projectProgress" min="0" max="100" step="5" value="0"><div class="d-flex justify-content-between"><small>0%</small><small id="progressValue">0%</small><small>100%</small></div></div>
                            
                            <!-- Budget & Resources -->
                            <div class="card mt-3 mb-3"><div class="card-header"><h6 class="card-title mb-0">Budget & Resources</h6></div><div class="card-body"><div class="row"><div class="col-md-6"><div class="mb-3"><label class="form-label">Annual Budget ($)</label><input type="number" class="form-control" id="projectBudget" min="0" step="1000"></div></div><div class="col-md-6"><div class="mb-3"><label class="form-label">FTE Allocation</label><input type="number" step="0.1" class="form-control" id="projectFTE" min="0" max="10"></div></div></div><div class="mb-3"><label class="form-label">Funding Source</label><select class="form-select" id="fundingSource"><option value="">Select funding source</option><option value="council">Council Budget</option><option value="state">State Grant</option><option value="federal">Federal Grant</option><option value="partnership">Partnership</option><option value="other">Other</option></select></div></div></div>
                            
                            <!-- Approval Workflow -->
                            <div class="card mt-3 mb-3"><div class="card-header"><h6 class="card-title mb-0">Approval Workflow</h6></div><div class="card-body"><div class="row"><div class="col-md-6"><label class="form-label">Approval Status</label><select class="form-select" id="approvalStatus"><option value="pending">Pending Review</option><option value="approved">Approved</option><option value="rejected">Rejected</option><option value="revision">Revision Required</option></select></div><div class="col-md-6"><label class="form-label">Reviewer Comments</label><textarea class="form-control" id="approvalComments" rows="2" placeholder="Reviewer comments..."></textarea></div></div></div></div>
                            
