```css
/* Improved filter card styling */
.filter-label {
    background: #f8f9fa;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.85rem;
}

.project-select-wrapper select {
    border-radius: 20px;
    padding: 6px 30px 6px 15px;
    background-color: #fff;
    transition: all 0.2s ease;
}

.project-select-wrapper select:hover {
    border-color: var(--accent);
    box-shadow: 0 2px 8px rgba(58, 138, 95, 0.1);
}

.view-mode-buttons .btn {
    border-radius: 20px;
    padding: 6px 16px;
    transition: all 0.2s ease;
}

.view-mode-buttons .btn-group .btn:first-child {
    border-radius: 20px 0 0 20px;
}

.view-mode-buttons .btn-group .btn:last-child {
    border-radius: 0 20px 20px 0;
}

.view-mode-buttons .btn.active {
    background-color: var(--accent);
    border-color: var(--accent);
    color: white;
}

.mode-indicator .badge {
    border-radius: 20px;
    font-weight: 500;
    font-size: 0.8rem;
    background-color: #e8f5e9 !important;
    color: #2e7d32 !important;
}

/* Responsive adjustments */
@media (max-width: 768px) {
    .d-flex.flex-wrap {
        flex-direction: column;
        align-items: stretch !important;
    }
    
    .project-select-wrapper {
        width: 100%;
    }
    
    .view-mode-buttons {
        width: 100%;
    }
    
    .view-mode-buttons .btn-group {
        width: 100%;
    }
    
    .view-mode-buttons .btn {
        flex: 1;
    }
}
