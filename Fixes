3. Missing Error Handling in loadCalendar

The calendar initialization could fail silently. Add error handling:

```javascript
function loadCalendar() {
    const calendarEl = document.getElementById('calendar');
    if (!calendarEl) {
        console.warn("Calendar element not found");
        return;
    }
    
    try {
        if (calendar) {
            calendar.destroy();
        }
        
        calendar = new FullCalendar.Calendar(calendarEl, {
            // ... existing config
        });
        
        calendar.render();
    } catch (error) {
        console.error("Calendar initialization failed:", error);
        showToast("Calendar Error", "Could not load calendar view", "error");
    }
}
```

4. Health Score Preview Initial State

The health score preview shows default values but doesn't calculate initial score. Add this to setupHealthScorePreview:

```javascript
function setupHealthScorePreview() {
    const inputs = ['vegetationCover', 'nativeSpecies', 'weedCover', 'soilStability', 'speciesRichness'];
    
    inputs.forEach(inputId => {
        const input = document.getElementById(inputId);
        if (input) {
            input.addEventListener('input', updateHealthScorePreview);
        }
    });
    
    // Add this line to calculate initial preview
    setTimeout(updateHealthScorePreview, 100);
}
```

