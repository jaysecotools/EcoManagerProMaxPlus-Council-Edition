<script>
// ==================== COMPLETE ENHANCED APPLICATION ====================

// Global variables
let currentUser = { role: 'viewer', name: 'Demo User', permissions: [] };
let projectMap = null, projectMarker = null, modalProjectMap = null, calendar = null;
let projectStatusChart = null, healthTrendChart = null, analyticsHealthTrendChart = null;
let speciesTypeChart = null, maintenanceTypeChart = null, monthlyActivityChart = null;
let forecastChart = null, historicalWeatherChart = null;
let currentTimeRange = 6;
let currentPolygonLayer = null;
let drawnItems = null;

// Audit Log System
let auditLog = JSON.parse(localStorage.getItem('auditLog') || '[]');
function addAuditLog(action, details) {
    const logEntry = {
        id: Date.now(),
        timestamp: new Date().toISOString(),
        user: currentUser.role,
        action: action,
        details: details,
        ip: 'client-side'
    };
    auditLog.unshift(logEntry);
    if (auditLog.length > 500) auditLog = auditLog.slice(0, 500);
    localStorage.setItem('auditLog', JSON.stringify(auditLog));
    console.log('Audit:', logEntry);
}

// Toast notification with styling
function showToast(title, message, type = 'success') {
    const toast = document.getElementById('liveToast');
    if (!toast) return;
    document.getElementById('toast-title').textContent = title;
    document.getElementById('toast-message').innerHTML = message;
    const header = toast.querySelector('.toast-header');
    header.className = 'toast-header';
    if (type === 'error') header.classList.add('bg-danger', 'text-white');
    else if (type === 'warning') header.classList.add('bg-warning', 'text-dark');
    else if (type === 'info') header.classList.add('bg-info', 'text-white');
    else header.classList.add('bg-success', 'text-white');
    new bootstrap.Toast(toast).show();
}

function formatDate(dateString) {
    if (!dateString) return 'Not specified';
    return new Date(dateString).toLocaleDateString('en-AU');
}

function getProjectName(projectId) {
    if (!projectId) return 'Unassigned';
    const project = db.getProjects().find(p => p.id === projectId);
    return project ? project.name : 'Unknown Project';
}

function getHealthBadgeClass(health) {
    const map = { excellent: 'bg-success', good: 'bg-info', fair: 'bg-warning', poor: 'bg-danger', degraded: 'bg-dark' };
    return map[health] || 'bg-secondary';
}

function getPriorityBadgeClass(priority) {
    const map = { low: 'bg-info', medium: 'bg-warning', high: 'bg-danger' };
    return map[priority] || 'bg-secondary';
}

function checkPermission(permission) {
    if (currentUser.permissions.includes('all')) return true;
    return currentUser.permissions.includes(permission);
}

// Data validation
function validateProjectData(project) {
    if (!project.name || project.name.trim().length < 2) {
        showToast('Validation Error', 'Project name must be at least 2 characters', 'error');
        return false;
    }
    if (project.startDate && !/^\d{4}-\d{2}-\d{2}$/.test(project.startDate)) {
        showToast('Validation Error', 'Invalid date format', 'error');
        return false;
    }
    if (project.latitude && (project.latitude < -90 || project.latitude > 90)) {
        showToast('Validation Error', 'Invalid latitude (-90 to 90)', 'error');
        return false;
    }
    if (project.longitude && (project.longitude < -180 || project.longitude > 180)) {
        showToast('Validation Error', 'Invalid longitude (-180 to 180)', 'error');
        return false;
    }
    return true;
}

// ==================== ECOSYSTEM SCORING SYSTEM ====================
const ecosystemScoring = {
    calculateHealthScore: function(data) {
        const scores = {
            vegetation: Math.min((parseFloat(data.vegetationCover || 0) * 0.5 + parseFloat(data.nativeSpecies || 0) * 0.5), 100),
            weeds: Math.max(0, 100 - (parseFloat(data.weedCover || 0) * 1.5)),
            soil: (parseInt(data.soilStability || 3) - 1) * 25,
            biodiversity: Math.min(parseInt(data.speciesRichness || 0) * 5, 100)
        };
        const totalScore = Math.round(scores.vegetation * 0.3 + scores.weeds * 0.3 + scores.soil * 0.2 + scores.biodiversity * 0.2);
        const rating = totalScore >= 80 ? 'excellent' : totalScore >= 60 ? 'good' : totalScore >= 40 ? 'fair' : totalScore >= 20 ? 'poor' : 'degraded';
        return { total: totalScore, rating: rating, breakdown: scores };
    },
    getHealthColor: (score) => score >= 80 ? 'success' : score >= 60 ? 'info' : score >= 40 ? 'warning' : score >= 20 ? 'danger' : 'dark'
};

