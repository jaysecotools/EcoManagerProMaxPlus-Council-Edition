// ==================== REPLACE YOUR ENTIRE initApp FUNCTION WITH THIS ====================
function initApp() {
    // Make functions globally available FIRST (critical for local files)
    window.navigateTo = navigateTo;
    window.deleteProject = deleteProject;
    window.deleteAssessment = deleteAssessment;
    window.deleteSpecies = deleteSpecies;
    window.deleteMaintenance = deleteMaintenance;
    window.completeMaintenance = completeMaintenance;
    window.showProjectInModal = showProjectInModal;
    window.userOnboarding = userOnboarding;
    window.formBuilder = formBuilder;
    window.login = login;
    window.logout = logout;
    
    // Initialize data and UI
    db.init();
    setupFormHandlers();
    setupViewToggle();
    loadDashboard();
    loadProjects();
    loadAssessments();
    loadSpecies();
    loadMaintenance();
    loadDataSummary();
    initApiKeyManagement();
    
    // FIXED: Use event delegation instead of direct binding
    // This works for local files because the parent element exists
    document.querySelector('.sidebar').addEventListener('click', function(e) {
        const link = e.target.closest('.nav-link[data-target]');
        if (link) {
            e.preventDefault();
            navigateTo(link.getAttribute('data-target'));
        }
    });
    
    document.querySelector('.main-content').addEventListener('click', function(e) {
        const quickBtn = e.target.closest('.quick-action-btn');
        if (quickBtn) {
            navigateTo(quickBtn.getAttribute('data-target'));
        }
    });
    
    window.addEventListener('resize', fixMobileLayout);
    fixMobileLayout();
    AOS.init({ duration: 800, once: true });
}

// ==================== REPLACE YOUR EXISTING DOM CONTENT LOADED WITH THIS ====================
// This ensures the app starts correctly for both web servers and local files
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initApp);
} else {
    initApp(); // DOM already ready
}
