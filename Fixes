        // Save the PDF
        const fileName = `Maintenance_Report_${new Date().toISOString().slice(0, 10)}.pdf`;
        doc.save(fileName);
        
        showToast('PDF Export Successful', 'Maintenance report generated successfully', 'success');
        
    } catch (error) {
        console.error('PDF Export Error:', error);
        showToast('Export Failed', 'Error: ' + error.message, 'error');
    }
}
