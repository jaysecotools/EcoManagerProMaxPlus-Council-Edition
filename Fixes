Just add this one function to your code (put it anywhere inside the <script> tag, near the other functions):

```javascript
function fixExistingData() {
    let maintenance = JSON.parse(localStorage.getItem('maintenance') || '[]');
    let changed = false;
    
    for (let i = 0; i < maintenance.length; i++) {
        if (maintenance[i].activity && maintenance[i].activity.includes('&')) {
            // Fix the corrupted text
            let fixed = maintenance[i].activity
                .replace(/&amp;/g, '&')
                .replace(/&#x27;/g, "'")
                .replace(/&quot;/g, '"')
                .replace(/&#x2F;/g, '/')
                .replace(/&lt;/g, '<')
                .replace(/&gt;/g, '>')
                .replace(/&amp;/g, '&'); // One more time for safety
            
            if (fixed !== maintenance[i].activity) {
                console.log('Fixing:', maintenance[i].activity, '→', fixed);
                maintenance[i].activity = fixed;
                changed = true;
            }
        }
    }
    
    if (changed) {
        localStorage.setItem('maintenance', JSON.stringify(maintenance));
        alert('Fixed ' + changed + ' corrupted items. Refresh the page to see the fix.');
        location.reload();
    } else {
        alert('No corrupted data found. Try adding a new maintenance task - it should work correctly now.');
    }
}
```

Then, open your browser's console (F12) and type:

```javascript
