        sanitizeInput: function(input) {
            // For storage - keep the original text, don't convert to HTML entities
            // This prevents the & symbols from appearing in your PDF
            if (typeof input === 'string') {
                // Only remove the absolute minimum for XSS protection
                // Keep apostrophes, quotes, and slashes as-is
                return input
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;');
            }
            return input;
        }
    };
