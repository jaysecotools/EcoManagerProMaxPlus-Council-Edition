function importData() {
    const fileInput = document.getElementById('importFile');
    if (!fileInput?.files.length) { showToast('Import Error', 'Select a JSON file', 'error'); return; }
    const reader = new FileReader();
    reader.onload = function(e) {
        try {
            const data = JSON.parse(e.target.result);
            if (document.getElementById('overwriteData')?.checked) {
                if (data.projects) localStorage.setItem('projects', JSON.stringify(data.projects));
                if (data.assessments) localStorage.setItem('assessments', JSON.stringify(data.assessments));
                if (data.species) localStorage.setItem('species', JSON.stringify(data.species));
                if (data.maintenance) localStorage.setItem('maintenance', JSON.stringify(data.maintenance));
                showToast('Import Successful', 'Data overwritten', 'success');
            } else {
                // Merge logic
                const existingProjects = db.getProjects();
                const newProjects = data.projects || [];
                const mergedProjects = [...existingProjects, ...newProjects.filter(p => !existingProjects.some(ep => ep.id === p.id))];
                localStorage.setItem('projects', JSON.stringify(mergedProjects));
                showToast('Import Successful', 'Data merged', 'success');
            }
            loadDashboard(); loadProjects(); loadAssessments(); loadSpecies(); loadMaintenance(); loadDataSummary();
            fileInput.value = '';
            addAuditLog('import_data', 'JSON import performed');
        } catch(e) { showToast('Import Error', 'Invalid JSON file', 'error'); }
    };
    reader.readAsText(fileInput.files[0]);
}

