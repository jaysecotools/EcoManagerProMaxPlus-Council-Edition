<style>
        :root {
            --primary: #2c5530;
            --secondary: #4a7c59;
            --accent: #3a8a5f;
            --accent-light: #4da675;
            --success: #28a745;
            --warning: #ffc107;
            --danger: #dc3545;
            --light: #f8f9fa;
            --dark: #1e2b1e;
            --sidebar-width: 280px;
            --transition: all 0.3s ease;
            --info: #17a2b8;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fa;
            color: #2c3e50;
            line-height: 1.6;
            overflow-x: hidden;
        }

        /* Sidebar Styles */
        .sidebar {
            min-height: 100vh;
            width: var(--sidebar-width);
            background: linear-gradient(to bottom, var(--primary), var(--secondary));
            color: white;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
            transition: var(--transition);
            box-shadow: 3px 0 15px rgba(0, 0, 0, 0.1);
        }

        .sidebar .nav-link {
            color: rgba(255, 255, 255, 0.85);
            margin-bottom: 5px;
            border-radius: 8px;
            padding: 12px 15px;
            transition: var(--transition);
            font-weight: 500;
        }

        .sidebar .nav-link:hover, .sidebar .nav-link.active {
            color: white;
            background-color: rgba(255, 255, 255, 0.1);
            transform: translateX(5px);
        }

        .sidebar .nav-link i {
            margin-right: 12px;
            font-size: 1.2rem;
            width: 24px;
            text-align: center;
        }

        .logo {
            font-weight: 700;
            padding: 20px 25px;
            font-size: 1.4rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            align-items: center;
            background-color: rgba(0, 0, 0, 0.1);
        }

        .logo i {
            margin-right: 10px;
            color: var(--accent-light);
        }

/* Main Content - CRITICAL FIX */
.main-content {
    flex: 1;
    padding: 0; /* Changed from 30px to 15px, then to 0 */
    transition: var(--transition);
    min-height: 100vh;
    min-width: 0;
    overflow-x: auto;
    position: relative;
    z-index: 1;
}

/* Ensure container-fluid doesn't cause overflow */
.container-fluid {
    padding: 0;
    overflow-x: hidden;
}

/* Fix for flex layout */
.d-flex {
    display: flex !important;
    align-items: flex-start;
    width: 100%;
}

/* Sidebar fix for flex layout */
.sidebar {
    flex-shrink: 0;
    width: var(--sidebar-width);
    position: relative;
    min-height: 100vh;
}

/* Fix for row within main-content */
.main-content .row {
    margin-left: 0;
    margin-right: 0;
    width: 100%;
}

/* Ensure all cards and content stay within bounds */
.main-content .card,
.main-content .col-md-*,
.main-content .col-* {
    width: 100%;
    max-width: 100%;
}

/* Fix for the specific chart container that might be causing issues */
.main-content .col-md-8,
.main-content .col-md-4 {
    padding-left: 15px;
    padding-right: 15px;
}

/* Mobile responsiveness fix */
@media (max-width: 992px) {
    .sidebar {
        width: 70px;
        overflow: hidden;
    }
    
    .sidebar .logo span {
        display: none;
    }
    
    .sidebar .nav-link span {
        display: none;
    }
    
    .sidebar .nav-link i {
        margin-right: 0;
        font-size: 1.4rem;
    }
    
    .sidebar:hover {
        width: var(--sidebar-width);
    }
    
    .sidebar:hover .logo span {
        display: inline;
    }
    
    .sidebar:hover .nav-link span {
        display: inline;
    }
    
    .sidebar:hover .nav-link i {
        margin-right: 12px;
    }
    
    .main-content {
        padding: 20px;
    }
}

@media (max-width: 768px) {
    .container-fluid > .d-flex {
        flex-direction: column;
    }
    
    .sidebar {
        width: 100%;
        height: 70px;
        min-height: 70px;
        bottom: 0;
        top: auto;
        position: fixed;
        z-index: 1000;
    }
    
    .sidebar .logo {
        display: none;
    }
    
    .sidebar .nav {
        flex-direction: row;
        overflow-x: auto;
        padding: 0.5rem;
    }
    
    .sidebar .nav-item {
        flex-shrink: 0;
    }
    
    .sidebar .nav-link {
        padding: 0.5rem;
        margin-bottom: 0;
        margin-right: 5px;
        border-radius: 5px;
        text-align: center;
        font-size: 0.8rem;
    }
    
    .sidebar .nav-link i {
        margin-right: 0;
        display: block;
        margin-bottom: 0.25rem;
        font-size: 1.2rem;
    }
    
    .main-content {
        margin-left: 0;
        margin-bottom: 70px;
        padding: 15px;
        width: 100%;
    }
}

