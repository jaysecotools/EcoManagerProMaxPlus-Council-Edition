// Add this function to ensure hiding on mobile after navigation
function enforceMobileDashboardHide() {
    if (window.innerWidth <= 768) {
        const activeSection = document.querySelector('.content-section.active');
        const dashboardOnlyElements = document.querySelectorAll('[data-dashboard-only="true"]');
        
        if (activeSection && activeSection.id !== 'dashboard') {
            dashboardOnlyElements.forEach(el => {
                el.style.display = 'none';
                el.style.visibility = 'hidden';
                el.style.height = '0';
                el.style.overflow = 'hidden';
                el.style.margin = '0';
                el.style.padding = '0';
            });
        } else if (activeSection && activeSection.id === 'dashboard') {
            dashboardOnlyElements.forEach(el => {
                el.style.display = 'flex';
                el.style.visibility = 'visible';
                el.style.height = 'auto';
                el.style.overflow = 'visible';
                el.style.margin = '';
                el.style.padding = '';
            });
        }
    }
}

