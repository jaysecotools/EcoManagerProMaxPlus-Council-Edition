            return {
                current: { temp_c: 18 + Math.sin(Date.now() / 1000000) * 5, condition: { text: "Partly Cloudy", code: "1003" }, humidity: 65 + Math.sin(Date.now() / 2000000) * 10, wind_kph: 12 + Math.random() * 8, pressure_mb: 1015 + Math.random() * 10, uv: 6 + Math.random() * 4, vis_km: 10 + Math.random() * 5, air_quality: { 'us-epa-index': 2 } },
                location: { name: "Burnie, Tasmania", region: "Tasmania", country: "Australia" }
            };
        }

        function showExampleWeatherData() {
            const exampleData = { current: { temp_c: 18, condition: { text: "Partly Cloudy", code: "1003" }, humidity: 65, wind_kph: 12, pressure_mb: 1015, uv: 6, vis_km: 10, air_quality: { 'us-epa-index': 2 } }, location: { name: "Burnie, Tasmania", region: "Tasmania", country: "Australia" } };
            document.getElementById('current-temp').textContent = `${exampleData.current.temp_c}°C`;
            document.getElementById('weather-description').textContent = exampleData.current.condition.text;
            document.getElementById('humidity').textContent = `${exampleData.current.humidity}%`;
