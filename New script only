y', 'success'); fileInput.value = ''; } catch (error) { console.error('Import error:', error); showToast('Import Error', 'Failed to import data. Please check the file format.', 'error'); } }; reader.onerror = function() { showToast('Import Error', 'Failed to read the file', 'error'); }; reader.readAsText(file);
