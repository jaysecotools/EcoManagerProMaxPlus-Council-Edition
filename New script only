                        { id: '102', date: '2023-09-20', assessor: 'Sarah Johnson', health: 'excellent', projectId: '1', description: 'Significant improvement in native species diversity', scoringData: { vegetationCover: 85, nativeSpecies: 90, weedCover: 5, soilStability: 5, speciesRichness: 18 }, healthScore: { total: 88, rating: 'excellent' } }
