            showFormBuilder: function(projectId) { const interfaceDiv = document.getElementById('form-builder-interface'); if (!interfaceDiv) return; if (!projectId) { interfaceDiv.style.display = 'none'; return; } interfaceDiv.style.display = 'block'; interfaceDiv.innerHTML = this.createFormBuilderHTML(projectId); this.loadExistingForm(projectId); },
            createFormBuilderHTML: function(projectId) { return `<div class="border p-3 mb-3"><h6>Form Builder</h6><div class="mb-3"><label class="form-label">Form Title:</label><input type="text" class="form-control" id="formTitle" value="Custom Monitoring Form"></div><div class="mb-3"><label class="form-label">Add Field:</label><div class="btn-group mb-2"><button type="button" class="btn btn-sm btn-outline-primary" onclick="formBuilder.addField('text')"><i class="bi bi-text-paragraph"></i> Text</button><button type="button" class="btn btn-sm btn-outline-primary" onclick="formBuilder.addField('number')"><i class="bi bi-123"></i> Number</button><button type="button" class="btn btn-sm btn-outline-primary" onclick="formBuilder.addField('select')"><i class="bi bi-menu-down"></i> Dropdown</button><button type="button" class="btn btn-sm btn-outline-primary" onclick="formBuilder.addField('checkbox')"><i class="bi bi-check-square"></i> Checkbox</button></div></div><div id="form-preview" class="border p-3 bg-light"><h6>Form Preview</h6><form id="custom-form-preview"></form></div><div class="mt-3"><button class="btn btn-success" onclick="formBuilder.saveForm('${projectId}')"><i class="bi bi-save"></i> Save Form Template</button><button class="btn btn-outline-secondary" onclick="formBuilder.clearForm()"><i class="bi bi-trash"></i> Clear Form</button></div></div>`; },
            addField: function(type) { const fieldId = 'field_' + Date.now(); const field = { id: fieldId, type: type, label: 'New Field', required: false, options: type === 'select' ? ['Option 1', 'Option 2'] : [] }; this.currentForm.push(field); this.updateFormPreview(); },
            updateFormPreview: function() { const preview = document.getElementById('custom-form-preview'); if (!preview) return; preview.innerHTML = ''; this.currentForm.forEach((field, index) => { const fieldHTML = this.createFieldHTML(field, index); preview.innerHTML += fieldHTML; }); },
            createFieldHTML: function(field, index) { let inputHTML = ''; switch(field.type) { case 'text': inputHTML = `<input type="text" class="form-control" placeholder="Enter text">`; break; case 'number': inputHTML = `<input type="number" class="form-control" placeholder="Enter number">`; break; case 'select': const options = field.options.map(opt => `<option value="${opt}">${opt}</option>`).join(''); inputHTML = `<select class="form-select">${options}</select>`; break; case 'checkbox': inputHTML = `<div class="form-check"><input class="form-check-input" type="checkbox"><label class="form-check-label">${field.label}</label></div>`; break; } return `<div class="mb-3 form-builder-field" data-field-id="${field.id}"><div class="d-flex justify-content-between align-items-center"><label class="form-label">${dataValidator.sanitizeForHTML(field.label)}</label><button type="button" class="btn btn-sm btn-outline-danger" onclick="formBuilder.removeField(${index})"><i class="bi bi-trash"></i></button></div>${inputHTML}</div>`; },
            removeField: function(index) { this.currentForm.splice(index, 1); this.updateFormPreview(); },
            saveForm: function(projectId) { const formTitle = document.getElementById('formTitle').value || 'Custom Form'; const formConfig = { title: formTitle, fields: this.currentForm, createdAt: new Date().toISOString(), createdBy: currentUser.role }; const templates = JSON.parse(localStorage.getItem('formTemplates') || '{}'); templates[projectId] = formConfig; localStorage.setItem('formTemplates', JSON.stringify(templates)); auditLog.log('SAVE_FORM_TEMPLATE', { projectId: projectId, formTitle: formTitle, fieldCount: this.currentForm.length }); showToast('Form Saved', `Custom form "${formTitle}" has been saved for this project`, 'success'); },
            loadExistingForm: function(projectId) { const templates = JSON.parse(localStorage.getItem('formTemplates') || '{}'); const existingForm = templates[projectId]; if (existingForm) { this.currentForm = existingForm.fields || []; document.getElementById('formTitle').value = existingForm.title; this.updateFormPreview(); } else { this.currentForm = []; document.getElementById('formTitle').value = 'Custom Monitoring Form'; this.updateFormPreview(); } },
            clearForm: function() { if (confirm('Are you sure you want to clear the entire form?')) { this.currentForm = []; this.updateFormPreview(); } },
            loadFormTemplates: function() { if (!localStorage.getItem('formTemplates')) localStorage.setItem('formTemplates', JSON.stringify({})); }
        };

        const userOnboarding = {
            showTour: function() { introJs().setOptions({ steps: [{ element: document.querySelector('.logo'), intro: 'Welcome to EcoManager Pro! This is your council ecosystem management system.', position: 'right' }, { element: document.querySelector('.sidebar'), intro: 'Use the sidebar to navigate between different sections of the application.', position: 'right' }, { element: document.querySelector('#dashboard'), intro: 'The Dashboard gives you an overview of all your ecosystem management activities.', position: 'bottom' }, { element: document.querySelector('.quick-actions'), intro: 'Quick Actions let you quickly create new projects, assessments, species, and maintenance tasks.', position: 'bottom' }, { element: document.querySelector('#projects'), intro: 'Manage all your restoration projects here. Add locations, budgets, and track progress.', position: 'top' }, { element: document.querySelector('#assessments'), intro: 'Conduct ecosystem health assessments and track changes over time.', position: 'top' }, { element: document.querySelector('#weather'), intro: 'Monitor weather conditions and environmental factors that may affect your projects.', position: 'top' }, { element: document.querySelector('#currentUserRole'), intro: 'Your current role determines what actions you can perform.', position: 'left' }, { element: document.querySelector('#userGuideBtn'), intro: 'Access the full user guide for detailed instructions on using all features.', position: 'right' }], showProgress: true, showBullets: true, exitOnOverlayClick: true, keyboardNavigation: true }).start(); },
            showTooltips: function() { const tooltipElements = document.querySelectorAll('[data-help]'); tooltipElements.forEach(el => { el.setAttribute('title', el.getAttribute('data-help')); el.setAttribute('data-bs-toggle', 'tooltip'); }); var tooltipList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]')); tooltipList.map(function (tooltipTriggerEl) { return new bootstrap.Tooltip(tooltipTriggerEl); }); }
        };

        function deleteProject(id) { if (!checkPermission('create_projects')) { showToast('Permission Denied', 'You do not have permission to delete projects.', 'error'); return; } if (confirm('Are you sure you want to delete this project? This will also delete all associated assessments, species, and maintenance activities.')) { const assessments = db.getAssessments(); assessments.forEach(assessment => { if (assessment.projectId === id) db.deleteAssessment(assessment.id, currentUser.role); }); const species = db.getSpecies(); species.forEach(s => { if (s.projectId === id) db.deleteSpecies(s.id, currentUser.role); }); const maintenance = db.getMaintenance(); maintenance.forEach(item => { if (item.projectId === id) db.deleteMaintenance(item.id, currentUser.role); }); const success = db.deleteProject(id, currentUser.role); if (success) { loadProjects(); loadAssessments(); loadSpecies(); loadMaintenance(); loadDataSummary(); showToast('Success', 'Project and all associated items deleted successfully'); } } }
        function deleteAssessment(id) { if (!checkPermission('edit_assessments')) { showToast('Permission Denied', 'You do not have permission to delete assessments.', 'error'); return; } if (confirm('Are you sure you want to delete this assessment?')) { const success = db.deleteAssessment(id, currentUser.role); if (success) { loadAssessments(); loadDataSummary(); showToast('Success', 'Assessment deleted successfully'); } } }
        function deleteSpecies(id) { if (!checkPermission('edit_species')) { showToast('Permission Denied', 'You do not have permission to delete species.', 'error'); return; } if (confirm('Are you sure you want to delete this species?')) { const success = db.deleteSpecies(id, currentUser.role); if (success) { loadSpecies(); loadDataSummary(); showToast('Success', 'Species deleted successfully'); } } }
        function deleteMaintenance(id) { if (!checkPermission('edit_maintenance')) { showToast('Permission Denied', 'You do not have permission to delete maintenance activities.', 'error'); return; } if (confirm('Are you sure you want to delete this maintenance activity?')) { const success = db.deleteMaintenance(id, currentUser.role); if (success) { loadMaintenance(); loadDataSummary(); showToast('Success', 'Maintenance activity deleted successfully'); } } }
        function completeMaintenance(id) { if (!checkPermission('complete_maintenance')) { showToast('Permission Denied', 'You do not have permission to complete maintenance activities.', 'error'); return; } if (confirm('Mark this maintenance activity as completed?')) { const success = db.updateMaintenanceStatus(id, 'completed', currentUser.role); if (success) { loadMaintenance(); showToast('Success', 'Maintenance activity marked as completed'); } } }

        function setupViewToggle() {
            const viewButtons = document.querySelectorAll('.view-toggle button');
            const listView = document.getElementById('list-view');
            const calendarView = document.getElementById('calendar-view');
            viewButtons.forEach(button => { button.addEventListener('click', function() { const targetView = this.getAttribute('data-view'); viewButtons.forEach(btn => btn.classList.remove('active')); this.classList.add('active'); if (targetView === 'list-view') { listView.style.display = 'block'; calendarView.style.display = 'none'; } else if (targetView === 'calendar-view') { listView.style.display = 'none'; calendarView.style.display = 'block'; loadCalendar(); } }); });
        }

        function logout() { auditLog.log('USER_LOGOUT', { role: currentUser.role }); currentUser = { role: 'admin', name: 'System Administrator', permissions: [] }; currentUser.permissions = userRoles.admin.permissions; document.getElementById('currentUserRole').textContent = userRoles.admin.name; document.getElementById('currentUserRole').className = `badge bg-${userRoles.admin.color} text-dark mt-1`; showToast('Logged Out', 'You have been logged out', 'info'); loadDashboard(); loadProjects(); loadAssessments(); loadSpecies(); loadMaintenance(); loadCharts(); }

        document.getElementById('projectForm').addEventListener('submit', function(e) { e.preventDefault(); const isEdit = this.dataset.editId; if (isEdit && !checkPermission('edit_projects')) { showToast('Permission Denied', 'You do not have permission to edit projects.', 'error'); return; } else if (!isEdit && !checkPermission('create_projects')) { showToast('Permission Denied', 'You do not have permission to create projects.', 'error'); return; } const project = { name: document.getElementById('projectName').value, code: document.getElementById('projectCode').value, startDate: document.getElementById('projectStartDate').value, status: document.getElementById('projectStatus').value, progress: parseInt(document.getElementById('projectProgress').value) || 0, description: document.getElementById('projectDescription').value, latitude: document.getElementById('projectLatitude').value, longitude: document.getElementById('projectLongitude').value, budget: document.getElementById('projectBudget').value ? parseInt(document.getElementById('projectBudget').value) : null, fte: document.getElementById('projectFTE').value ? parseFloat(document.getElementById('projectFTE').value) : null, fundingSource: document.getElementById('fundingSource').value, approvalStatus: document.getElementById('approvalStatus').value, riskAssessment: document.getElementById('riskAssessment').value }; const editId = this.dataset.editId; if (editId) { const success = db.updateProject(editId, project, currentUser.role); if (success) { delete this.dataset.editId; this.querySelector('button[type="submit"]').textContent = 'Save Project'; showToast('Success', 'Project updated successfully'); } } else { const savedProject = db.saveProject(project, currentUser.role); if (savedProject) showToast('Success', 'Project created successfully'); } if (editId || project) { this.reset(); clearProjectMarker(); document.getElementById('projectProgress').value = 0; document.getElementById('progressValue').textContent = '0%'; loadProjects(); loadDataSummary(); } });
        document.getElementById('assessmentForm').addEventListener('submit', function(e) { e.preventDefault(); if (!checkPermission('create_assessments')) { showToast('Permission Denied', 'You do not have permission to create assessments.', 'error'); return; } const scoringData = { vegetationCover: document.getElementById('vegetationCover').value, nativeSpecies: document.getElementById('nativeSpecies').value, weedCover: document.getElementById('weedCover').value, soilStability: document.getElementById('soilStability').value, speciesRichness: document.getElementById('speciesRichness').value }; const healthScore = ecosystemScoring.calculateHealthScore(scoringData); const assessment = { date: document.getElementById('assessmentDate').value, assessor: document.getElementById('assessor').value, health: healthScore.rating, projectId: document.getElementById('assessmentProject').value, description: document.getElementById('assessmentDescription').value, scoringData: scoringData, healthScore: healthScore }; const savedAssessment = db.saveAssessment(assessment, currentUser.role); if (savedAssessment) { this.reset(); loadAssessments(); loadDataSummary(); showToast('Assessment Saved', `Health Score: ${healthScore.total}/100 (${healthScore.rating})`, ecosystemScoring.getHealthColor(healthScore.total)); } });
        document.getElementById('speciesForm').addEventListener('submit', function(e) { e.preventDefault(); if (!checkPermission('create_species')) { showToast('Permission Denied', 'You do not have permission to add species.', 'error'); return; } const species = { name: document.getElementById('speciesName').value, scientificName: document.getElementById('scientificName').value, type: document.getElementById('speciesType').value, status: document.getElementById('speciesStatus').value, projectId: document.getElementById('speciesProject').value, description: document.getElementById('speciesDescription').value }; const savedSpecies = db.saveSpecies(species, currentUser.role); if (savedSpecies) { this.reset(); loadSpecies(); loadDataSummary(); showToast('Success', 'Species added successfully'); } });
        document.getElementById('maintenanceForm').addEventListener('submit', function(e) { e.preventDefault(); if (!checkPermission('create_maintenance')) { showToast('Permission Denied', 'You do not have permission to schedule maintenance.', 'error'); return; } const maintenance = { activity: document.getElementById('maintenanceActivity').value, type: document.getElementById('maintenanceType').value, date: document.getElementById('maintenanceDate').value, priority: document.getElementById('maintenancePriority').value, projectId: document.getElementById('maintenanceProject').value, description: document.getElementById('maintenanceDescription').value }; const savedMaintenance = db.saveMaintenance(maintenance, currentUser.role); if (savedMaintenance) { this.reset(); loadMaintenance(); loadDataSummary(); showToast('Success', 'Maintenance activity scheduled successfully'); } });
        document.getElementById('documentUpload').addEventListener('change', function(e) { const files = e.target.files; if (!files.length) return; const projectId = document.getElementById('formBuilderProject').value; if (!projectId) { showToast('Error', 'Please select a project first', 'error'); this.value = ''; return; } for (let i = 0; i < files.length; i++) { const file = files[i]; if (file.size > 10 * 1024 * 1024) { showToast('Error', `File "${file.name}" exceeds 10MB limit`, 'error'); continue; } const document = { projectId: projectId, fileName: file.name, size: file.size, type: file.type, lastModified: file.lastModified }; db.saveDocument(document, currentUser.role); } loadProjectDocuments(projectId); showToast('Success', `${files.length} document(s) uploaded`, 'success'); this.value = ''; });
        document.getElementById('useCurrentLocation').addEventListener('click', useCurrentLocation);
        document.getElementById('clearLocation').addEventListener('click', clearProjectMarker);
        document.getElementById('projectProgress').addEventListener('input', function() { document.getElementById('progressValue').textContent = `${this.value}%`; });
        document.querySelectorAll('.quick-action-btn').forEach(btn => { btn.addEventListener('click', function() { const target = this.dataset.target; document.querySelectorAll('.sidebar .nav-link').forEach(l => l.classList.remove('active')); document.querySelector(`[data-target="${target}"]`).classList.add('active'); document.querySelectorAll('.content-section').forEach(section => { section.classList.remove('active'); }); setTimeout(() => { document.getElementById(target).classList.add('active'); if (target === 'dashboard') loadDashboard(); if (target === 'projects') { loadProjects(); setTimeout(() => { initProjectMap(); }, 100); } if (target === 'assessments') loadAssessments(); if (target === 'species') loadSpecies(); if (target === 'maintenance') { loadMaintenance(); document.querySelector('[data-view="list-view"]').click(); } if (target === 'charts') loadCharts(); if (target === 'data') { loadDataSummary(); loadProjectSelects(); } if (target === 'weather') loadWeatherData(); }, 50); }); });
        document.getElementById('assessmentProjectFilter').addEventListener('change', loadAssessments);
        document.getElementById('speciesProjectFilter').addEventListener('change', loadSpecies);
        document.getElementById('maintenanceProjectFilter').addEventListener('change', loadMaintenance);
        document.getElementById('projectSearch').addEventListener('input', function() { const searchTerm = this.value.toLowerCase(); const rows = document.querySelectorAll('#projects-table tr'); rows.forEach(row => { const text = row.textContent.toLowerCase(); if (text.includes(searchTerm)) row.style.display = ''; else row.style.display = 'none'; }); });
        document.getElementById('exportButton').addEventListener('click', exportData);
        document.getElementById('importButton').addEventListener('click', importData);
        document.getElementById('refreshWeather').addEventListener('click', loadWeatherData);
        document.getElementById('weatherLocationSelect').addEventListener('change', function() { localStorage.setItem('weatherLocation', this.value); loadWeatherData(); });
        document.getElementById('useManualCoords').addEventListener('click', function() { const lat = document.getElementById('manualLat').value; const lon = document.getElementById('manualLon').value; if (lat && lon) { const select = document.getElementById('weatherLocationSelect'); const manualOption = document.createElement('option'); manualOption.value = 'manual'; manualOption.textContent = `Manual (${lat}, ${lon})`; manualOption.dataset.lat = lat; manualOption.dataset.lon = lon; const existingManual = Array.from(select.options).find(opt => opt.value === 'manual'); if (existingManual) select.removeChild(existingManual); select.appendChild(manualOption); select.value = 'manual'; localStorage.setItem('weatherLocation', 'manual'); loadWeatherData(); } });
        document.querySelectorAll('.sidebar .nav-link').forEach(link => { link.addEventListener('click', function(e) { if (this.id === 'userGuideBtn') return; e.preventDefault(); document.querySelectorAll('.sidebar .nav-link').forEach(l => l.classList.remove('active')); this.classList.add('active'); const target = this.getAttribute('data-target'); document.querySelectorAll('.content-section').forEach(section => { section.classList.remove('active'); }); setTimeout(() => { document.getElementById(target).classList.add('active'); if (target === 'dashboard') loadDashboard(); if (target === 'projects') { loadProjects(); setTimeout(() => { initProjectMap(); }, 100); } if (target === 'assessments') loadAssessments(); if (target === 'species') loadSpecies(); if (target === 'maintenance') { loadMaintenance(); document.querySelector('[data-view="list-view"]').click(); } if (target === 'charts') loadCharts(); if (target === 'data') { loadDataSummary(); loadProjectSelects(); } if (target === 'weather') loadWeatherData(); }, 50); document.title = `${this.querySelector('span').textContent} | EcoManager Pro`; }); });

        function initApp() {
            db.init();
            auditLog.init();
            loadDashboard();
            loadProjectSelects();
            setupViewToggle();
            loadDataSummary();
            formBuilder.init();
            setupHealthScorePreview();
            setupHealthChartControls();
            setupWeatherLocationSelector();
            userOnboarding.showTooltips();
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) { return new bootstrap.Tooltip(tooltipTriggerEl); });
        }

        document.addEventListener('DOMContentLoaded', initApp);
    </script>
