        function getWeatherIcon(conditionCode) {
            const iconMap = { '1000': 'bi-sun', '1003': 'bi-cloud-sun', '1006': 'bi-cloud', '1009': 'bi-clouds', '1030': 'bi-cloud-haze', '1063': 'bi-cloud-drizzle', '1066': 'bi-snow', '1069': 'bi-cloud-sleet', '1072': 'bi-cloud-drizzle', '1087': 'bi-cloud-lightning', '1114': 'bi-wind', '1117': 'bi-wind', '1135': 'bi-cloud-haze', '1147': 'bi-cloud-haze', '1150': 'bi-cloud-drizzle', '1153': 'bi-cloud-drizzle', '1168': 'bi-cloud-haze', '1171': 'bi-cloud-haze', '1180': 'bi-cloud-drizzle', '1183': 'bi-cloud-rain', '1186': 'bi-cloud-rain', '1189': 'bi-cloud-rain', '1192': 'bi-cloud-rain-heavy', '1195': 'bi-cloud-rain-heavy', '1198': 'bi-cloud-haze', '1201': 'bi-cloud-haze', '1204': 'bi-cloud-sleet', '1207': 'bi-cloud-sleet', '1210': 'bi-snow', '1213': 'bi-snow', '1216': 'bi-snow', '1219': 'bi-snow', '1222': 'bi-snow', '1225': 'bi-snow', '1237': 'bi-snow', '1240': 'bi-cloud-rain', '1243': 'bi-cloud-rain-heavy', '1246': 'bi-cloud-rain-heavy', '1249': 'bi-cloud-sleet', '1252': 'bi-cloud-sleet', '1255': 'bi-snow', '1258': 'bi-snow', '1261': 'bi-snow', '1264': 'bi-snow', '1273': 'bi-cloud-lightning-rain', '1276': 'bi-cloud-lightning-rain', '1279': 'bi-cloud-lightning-rain', '1282': 'bi-cloud-lightning-rain' };
            return iconMap[conditionCode] || 'bi-cloud';
        }

        function updateWeatherDisplay(weatherData) {
            if (!weatherData || !weatherData.current) { showExampleWeatherData(); return; }
            const current = weatherData.current;
            document.getElementById('current-temp').textContent = `${Math.round(current.temp_c)}°C`;
            document.getElementById('weather-description').textContent = current.condition.text;
            document.getElementById('humidity').textContent = `${current.humidity}%`;
            document.getElementById('wind-speed').textContent = `${Math.round(current.wind_kph)} km/h`;
            document.getElementById('pressure').textContent = `${current.pressure_mb} hPa`;
            const weatherIcon = document.querySelector('.weather-icon i');
            if (weatherIcon) weatherIcon.className = `bi ${getWeatherIcon(current.condition.code)}`;
            const lastUpdateEl = document.getElementById('lastUpdate');
            if (lastUpdateEl) { lastUpdateEl.textContent = `Last updated: ${new Date().toLocaleTimeString('en-AU')}`; lastUpdateEl.style.fontStyle = 'normal'; lastUpdateEl.style.color = ''; }
        }

        function updateEnvironmentalAlerts(weatherData) {
            const alertsContainer = document.getElementById('environmental-alerts');
            alertsContainer.innerHTML = '';
            const alerts = [];
            if (!weatherData || !weatherData.current) {
                alerts.push({ type: 'info', icon: 'bi-info-circle', title: 'Demo Data', message: 'Showing demo weather data. Configure backend API for live updates.' });
                alerts.forEach(alert => { const alertElement = document.createElement('div'); alertElement.className = `alert alert-${alert.type} mb-2`; alertElement.innerHTML = `<i class="bi ${alert.icon} me-2"></i><strong>${alert.title}</strong><p class="mb-0">${alert.message}</p>`; alertsContainer.appendChild(alertElement); });
                return;
            }
            const current = weatherData.current;
            if (current.temp_c > 35) alerts.push({ type: 'danger', icon: 'bi-thermometer-high', title: 'Extreme Heat Warning', message: `Temperature is ${Math.round(current.temp_c)}°C. Avoid strenuous fieldwork.` });
            else if (current.temp_c > 30) alerts.push({ type: 'warning', icon: 'bi-thermometer-sun', title: 'High Temperature Alert', message: `Temperature is ${Math.round(current.temp_c)}°C. Consider adjusting schedules.` });
            else if (current.temp_c < 5) alerts.push({ type: 'info', icon: 'bi-thermometer-snow', title: 'Low Temperature Alert', message: `Temperature is ${Math.round(current.temp_c)}°C. Frost may affect sensitive species.` });
            if (current.condition.text.toLowerCase().includes('rain')) alerts.push({ type: 'info', icon: 'bi-cloud-rain', title: 'Rainfall Detected', message: 'Current rainfall may affect field work and monitoring activities.' });
            if (current.wind_kph > 20) alerts.push({ type: 'warning', icon: 'bi-wind', title: 'Windy Conditions', message: `Wind speed is ${Math.round(current.wind_kph)} km/h. May affect fieldwork safety.` });
            if (current.humidity > 85) alerts.push({ type: 'info', icon: 'bi-droplet', title: 'High Humidity', message: `Humidity is ${current.humidity}%. Monitor for fungal diseases.` });
            else if (current.humidity < 30) alerts.push({ type: 'warning', icon: 'bi-droplet', title: 'Low Humidity', message: `Humidity is ${current.humidity}%. Increased fire risk.` });
            if (alerts.length === 0) alerts.push({ type: 'success', icon: 'bi-check-circle', title: 'Favorable Conditions', message: 'Weather conditions are suitable for most ecosystem management activities.' });
            alerts.forEach(alert => { const alertElement = document.createElement('div'); alertElement.className = `alert alert-${alert.type} mb-2`; alertElement.innerHTML = `<i class="bi ${alert.icon} me-2"></i><strong>${alert.title}</strong><p class="mb-0">${alert.message}</p>`; alertsContainer.appendChild(alertElement); });
        }

        async function loadWeatherData() {
            const projects = db.getProjects();
            let lat, lon;
            const projectWithCoords = projects.find(p => p.latitude && p.longitude);
            if (projectWithCoords) { lat = projectWithCoords.latitude; lon = projectWithCoords.longitude; }
            else { lat = -41.0521; lon = 145.9061; }
            document.getElementById('weather-description').textContent = 'Loading weather data...';
            document.getElementById('lastUpdate').textContent = 'Updating...';
            try {
                const weatherData = await getWeatherByCoords(lat, lon);
                updateWeatherDisplay(weatherData);
                updateEnvironmentalAlerts(weatherData);
                const updateTime = new Date().toLocaleTimeString('en-AU');
                document.getElementById('lastUpdate').textContent = `Last updated: ${updateTime}`;
                updateForecastChart(weatherData);
                updateHistoricalWeatherChart();
            } catch (error) { console.error('Failed to load weather data:', error); document.getElementById('lastUpdate').textContent = 'Using demo data'; showExampleWeatherData(); loadMockWeatherData(); }
        }

        function loadMockWeatherData() {
            if (temperatureChart) temperatureChart.destroy();
            temperatureChart = new Chart(document.getElementById('temperatureChart'), { type: 'line', data: { labels: ['6 AM', '9 AM', '12 PM', '3 PM', '6 PM', '9 PM'], datasets: [{ label: 'Temperature (°C)', data: [12, 15, 18, 19, 17, 14], borderColor: 'rgb(255, 99, 132)', backgroundColor: 'rgba(255, 99, 132, 0.2)', tension: 0.4, fill: true }] }, options: { responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: false } } } });
            if (historicalWeatherChart) historicalWeatherChart.destroy();
            historicalWeatherChart = new Chart(document.getElementById('historicalWeatherChart'), { type: 'bar', data: { labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'], datasets: [{ label: 'Rainfall (mm)', data: [45, 52, 48, 62, 75, 82, 97, 94, 78, 64, 52, 48], backgroundColor: 'rgba(54, 162, 235, 0.8)', borderColor: 'rgba(54, 162, 235, 1)', borderWidth: 1, yAxisID: 'y' }, { label: 'Avg Temp (°C)', data: [22, 22, 20, 17, 14, 12, 11, 12, 14, 16, 18, 20], type: 'line', borderColor: 'rgb(255, 99, 132)', backgroundColor: 'rgba(255, 99, 132, 0.2)', yAxisID: 'y1' }] }, options: { responsive: true, maintainAspectRatio: false, scales: { y: { type: 'linear', display: true, position: 'left', title: { display: true, text: 'Rainfall (mm)' } }, y1: { type: 'linear', display: true, position: 'right', title: { display: true, text: 'Temperature (°C)' }, grid: { drawOnChartArea: false } } } } });
        }

        function updateForecastChart(weatherData) {
            const labels = ['Now', '+3h', '+6h', '+9h', '+12h', '+15h', '+18h', '+21h'];
            const temperatures = [18, 19, 20, 21, 19, 17, 16, 15];
            if (temperatureChart) temperatureChart.destroy();
            temperatureChart = new Chart(document.getElementById('temperatureChart'), { type: 'line', data: { labels: labels, datasets: [{ label: 'Temperature (°C)', data: temperatures, borderColor: 'rgb(255, 99, 132)', backgroundColor: 'rgba(255, 99, 132, 0.2)', tension: 0.4, fill: true }] }, options: { responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: false } } } });
