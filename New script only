            },
            getProjects: function() { return JSON.parse(localStorage.getItem('projects') || '[]'); },
            saveProject: function(project, user) { const validation = dataValidator.validateProject(project); if (!validation.isValid) { showToast('Validation Error', validation.errors.join('<br>'), 'error'); return null; } project.name = dataValidator.sanitizeInput(project.name); project.description = dataValidator.sanitizeInput(project.description); const projects = this.getProjects(); project.id = Date.now().toString(); project.createdBy = user; project.createdAt = new Date().toISOString(); projects.push(project); localStorage.setItem('projects', JSON.stringify(projects)); auditLog.log('CREATE_PROJECT', { projectId: project.id, projectName: project.name, status: project.status }); return project; },
            updateProject: function(id, updates, user) { const validation = dataValidator.validateProject(updates); if (!validation.isValid) { showToast('Validation Error', validation.errors.join('<br>'), 'error'); return false; } let projects = this.getProjects(); let updated = false; projects = projects.map(p => { if (p.id === id) { if (updates.name) updates.name = dataValidator.sanitizeInput(updates.name); if (updates.description) updates.description = dataValidator.sanitizeInput(updates.description); const oldStatus = p.status; const updatedProject = { ...p, ...updates, updatedBy: user, updatedAt: new Date().toISOString() }; if (oldStatus !== updates.status) auditLog.log('UPDATE_PROJECT_STATUS', { projectId: id, projectName: p.name, oldStatus: oldStatus, newStatus: updates.status }); auditLog.log('UPDATE_PROJECT', { projectId: id, projectName: p.name, updates: Object.keys(updates) }); updated = true; return updatedProject; } return p; }); if (updated) localStorage.setItem('projects', JSON.stringify(projects)); return updated; },
            deleteProject: function(id, user) { let projects = this.getProjects(); const projectToDelete = projects.find(p => p.id === id); if (!projectToDelete) return false; projects = projects.filter(p => p.id !== id); localStorage.setItem('projects', JSON.stringify(projects)); auditLog.log('DELETE_PROJECT', { projectId: id, projectName: projectToDelete.name, deletedBy: user }); return true; },
            getAssessments: function() { return JSON.parse(localStorage.getItem('assessments') || '[]'); },
            saveAssessment: function(assessment, user) { const validation = dataValidator.validateAssessment(assessment); if (!validation.isValid) { showToast('Validation Error', validation.errors.join('<br>'), 'error'); return null; } assessment.assessor = dataValidator.sanitizeInput(assessment.assessor); assessment.description = dataValidator.sanitizeInput(assessment.description); const assessments = this.getAssessments(); assessment.id = Date.now().toString(); assessment.createdBy = user; assessment.createdAt = new Date().toISOString(); assessments.push(assessment); localStorage.setItem('assessments', JSON.stringify(assessments)); auditLog.log('CREATE_ASSESSMENT', { assessmentId: assessment.id, projectId: assessment.projectId, healthScore: assessment.healthScore?.total }); return assessment; },
            deleteAssessment: function(id, user) { let assessments = this.getAssessments(); const assessmentToDelete = assessments.find(a => a.id === id); if (!assessmentToDelete) return false; assessments = assessments.filter(a => a.id !== id); localStorage.setItem('assessments', JSON.stringify(assessments)); auditLog.log('DELETE_ASSESSMENT', { assessmentId: id, deletedBy: user }); return true; },
            getSpecies: function() { return JSON.parse(localStorage.getItem('species') || '[]'); },
            saveSpecies: function(species, user) { const allSpecies = this.getSpecies(); species.id = Date.now().toString(); species.createdBy = user; species.createdAt = new Date().toISOString(); allSpecies.push(species); localStorage.setItem('species', JSON.stringify(allSpecies)); auditLog.log('CREATE_SPECIES', { speciesId: species.id, speciesName: species.name, projectId: species.projectId }); return species; },
            deleteSpecies: function(id, user) { let allSpecies = this.getSpecies(); const speciesToDelete = allSpecies.find(s => s.id === id); if (!speciesToDelete) return false; allSpecies = allSpecies.filter(s => s.id !== id); localStorage.setItem('species', JSON.stringify(allSpecies)); auditLog.log('DELETE_SPECIES', { speciesId: id, speciesName: speciesToDelete.name, deletedBy: user }); return true; },
            getMaintenance: function() { return JSON.parse(localStorage.getItem('maintenance') || '[]'); },
            saveMaintenance: function(maintenance, user) { const maintenanceItems = this.getMaintenance(); maintenance.id = Date.now().toString(); maintenance.status = 'scheduled'; maintenance.createdBy = user; maintenance.createdAt = new Date().toISOString(); maintenanceItems.push(maintenance); localStorage.setItem('maintenance', JSON.stringify(maintenanceItems)); auditLog.log('CREATE_MAINTENANCE', { maintenanceId: maintenance.id, activity: maintenance.activity, projectId: maintenance.projectId }); return maintenance; },
            updateMaintenanceStatus: function(id, status, user) { let maintenanceItems = this.getMaintenance(); let updated = false; maintenanceItems = maintenanceItems.map(item => { if (item.id === id) { const oldStatus = item.status; item.status = status; if (status === 'completed') { item.completedDate = new Date().toISOString().split('T')[0]; item.completedBy = user; } item.updatedAt = new Date().toISOString(); auditLog.log('UPDATE_MAINTENANCE_STATUS', { maintenanceId: id, activity: item.activity, oldStatus: oldStatus, newStatus: status }); updated = true; } return item; }); if (updated) localStorage.setItem('maintenance', JSON.stringify(maintenanceItems)); return updated; },
            deleteMaintenance: function(id, user) { let maintenanceItems = this.getMaintenance(); const maintenanceToDelete = maintenanceItems.find(m => m.id === id); if (!maintenanceToDelete) return false; maintenanceItems = maintenanceItems.filter(m => m.id !== id); localStorage.setItem('maintenance', JSON.stringify(maintenanceItems)); auditLog.log('DELETE_MAINTENANCE', { maintenanceId: id, activity: maintenanceToDelete.activity, deletedBy: user }); return true; },
            saveDocument: function(document, user) { const documents = JSON.parse(localStorage.getItem('documents') || '[]'); document.id = Date.now().toString(); document.uploadedBy = user; document.uploadedAt = new Date().toISOString(); documents.push(document); localStorage.setItem('documents', JSON.stringify(documents)); auditLog.log('UPLOAD_DOCUMENT', { documentId: document.id, fileName: document.fileName, projectId: document.projectId }); return document; },
            getDocumentsByProject: function(projectId) { const documents = JSON.parse(localStorage.getItem('documents') || '[]'); return documents.filter(doc => doc.projectId === projectId); }
        };

        let calendar = null;
        let projectStatusChart = null, healthTrendChart = null, currentChartMode = 'aggregated', currentProjectFilter = 'all', currentTimeRange = 6;
        let analyticsHealthTrendChart = null, speciesTypeChart = null, maintenanceTypeChart = null, monthlyActivityChart = null, temperatureChart = null, historicalWeatherChart = null;

        function showToast(title, message, type = 'success') {
            const toast = document.getElementById('liveToast');
            const toastTitle = document.getElementById('toast-title');
            const toastMessage = document.getElementById('toast-message');
            toastTitle.textContent = title;
            toastMessage.innerHTML = message;
            const header = toast.querySelector('.toast-header');
            header.className = 'toast-header';
            if (type === 'error') header.classList.add('bg-danger', 'text-white');
            else if (type === 'warning') header.classList.add('bg-warning', 'text-dark');
            else if (type === 'info') header.classList.add('bg-info', 'text-white');
            else header.classList.add('bg-success', 'text-white');
            const bsToast = new bootstrap.Toast(toast);
            bsToast.show();
        }

        function checkPermission(permission) { if (currentUser.permissions.includes('all')) return true; return currentUser.permissions.includes(permission); }

        async function getWeatherByCoords(lat, lon) { return getDemoWeatherData(lat, lon); }
        
