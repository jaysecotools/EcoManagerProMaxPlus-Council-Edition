                    const sampleProjects = [
                        { id: '1', name: 'Burnie Coastal Restoration', code: 'BCR001', startDate: '2023-01-15', status: 'active', progress: 65, description: 'Restoration of coastal vegetation in Burnie area', latitude: -41.0521, longitude: 145.9061, budget: 150000, fte: 2.5, fundingSource: 'council', approvalStatus: 'approved', documents: [], riskAssessment: 'Moderate risk due to coastal erosion' },
                        { id: '2', name: 'Tasmanian Wetlands Preservation', code: 'TWP002', startDate: '2023-03-10', status: 'planning', progress: 20, description: 'Preservation and monitoring of wetland ecosystems', latitude: -42.8821, longitude: 147.3272, budget: 85000, fte: 1.5, fundingSource: 'state', approvalStatus: 'pending_review', documents: [], riskAssessment: 'Low risk, high environmental value' }
